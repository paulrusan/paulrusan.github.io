  .us-chip--4 { animation: us-chip-hi 4.8s ease-in-out infinite 3.6s; }
  @keyframes us-chip-hi {
    0%, 100%  { fill: #FFFFFF; stroke: #E8E2D8; }
    12%, 28%  { fill: #EAF3EC; stroke: #2F6B4E; }
  }

  .us-chip-flow { offset-rotate: 0deg; }
