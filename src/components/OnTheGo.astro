---
// OnTheGo — animated multi-device sync graphic, vanilla JS + Astro (no React)
const bars = [42, 58, 51, 67, 73, 64, 81, 92, 88, 96];
const INITIAL_BALANCE = 28650; // BASE_BALANCE(24370) + 4280
---

<div class="otg-shell" id="otg-root">
  <div class="otg-grid" aria-hidden="true"></div>
  <div class="otg-glow otg-glow--a" aria-hidden="true"></div>
  <div class="otg-glow otg-glow--b" aria-hidden="true"></div>

  <!-- chrome -->
  <div class="otg-chrome">
    <div class="otg-dots"><span></span><span></span><span></span></div>
    <div class="otg-title">accountium / mobile</div>
    <div class="otg-live"><span class="otg-live-dot"></span> live</div>
  </div>

  <!-- scene -->
  <div class="otg-scene">

    <!-- SVG sync connector -->
    <svg class="otg-connector" viewBox="0 0 560 320" preserveAspectRatio="none" aria-hidden="true">
      <path id="otg-sync-path"
        d="M 190 105 C 240 80, 280 130, 320 165"
        fill="none" stroke="#D7CFC2" stroke-width="1.3" stroke-dasharray="3 5"/>
      <circle id="otg-sync-packet" r="4" fill="#2F6B4E" opacity="0">
        <animateMotion id="otg-anim-motion" dur="1.2s" repeatCount="1" begin="indefinite"
          keyPoints="0;1" keyTimes="0;1" calcMode="spline" keySplines="0.2 0.7 0.2 1">
          <mpath href="#otg-sync-path"/>
        </animateMotion>
        <animate id="otg-anim-opacity" attributeName="opacity"
          values="0;1;1;0" keyTimes="0;0.1;0.8;1"
          dur="1.2s" repeatCount="1" begin="indefinite"/>
      </circle>
    </svg>

    <!-- Laptop (behind, right) -->
    <div class="otg-laptop">
      <div class="otg-laptop-chrome">
        <span></span><span></span><span></span>
        <span class="otg-laptop-title">accountium.app</span>
      </div>
      <div class="otg-laptop-body">
        <div class="otg-laptop-stats">
          <div class="otg-laptop-stat">
            <div class="otg-laptop-stat-label">Operating · USD</div>
            <div class="otg-laptop-stat-val" id="otg-laptop-val">${INITIAL_BALANCE.toLocaleString('en-US', {minimumFractionDigits:2})}</div>
          </div>
          <div class="otg-laptop-trend">
            <span class="otg-trend-pill">▲ 12.4%</span>
          </div>
        </div>
        <div class="otg-laptop-bars" aria-hidden="true">
          {bars.map(h => <div class="otg-bar" style={`height:${h}%`}></div>)}
        </div>
        <div class="otg-laptop-foot">
          <span id="otg-laptop-recent" class="otg-laptop-recent">Recent · 3 new</span>
          <span class="otg-laptop-dot"></span>
          <span class="otg-laptop-sync-label">synced</span>
        </div>
      </div>
    </div>

    <!-- Phone (front, left) -->
    <div class="otg-phone">
      <div class="otg-phone-frame">
        <div class="otg-phone-notch" aria-hidden="true"></div>
        <div class="otg-phone-screen">

          <!-- status bar -->
          <div class="otg-status">
            <span>9:41</span>
            <div class="otg-status-icons">
              <svg width="14" height="9" viewBox="0 0 14 9" fill="#1A1714">
                <rect x="0" y="6" width="2" height="3"/>
                <rect x="3" y="4" width="2" height="5"/>
                <rect x="6" y="2" width="2" height="7"/>
                <rect x="9" y="0" width="2" height="9"/>
              </svg>
              <svg width="16" height="8" viewBox="0 0 16 8" fill="none">
                <rect x="0.5" y="0.5" width="13" height="7" rx="1.4" stroke="#1A1714"/>
                <rect x="14" y="3" width="1.5" height="2" fill="#1A1714"/>
                <rect x="2" y="2" width="9" height="4" fill="#2F6B4E" rx="0.6"/>
              </svg>
            </div>
          </div>

          <!-- app nav -->
          <div class="otg-app-nav">
            <div class="otg-app-brand">
              <span class="otg-app-mark">A</span>
              <span>Accountium</span>
            </div>
            <div class="otg-app-avatar">MO</div>
          </div>

          <!-- balance hero -->
          <div class="otg-hero">
            <div class="otg-hero-label">Today · Operating</div>
            <div id="otg-hero-val" class="otg-hero-val">${INITIAL_BALANCE.toLocaleString('en-US', {minimumFractionDigits:2})}</div>
            <div class="otg-hero-meta">
              <span id="otg-hero-up" class="otg-hero-up">▲ +$4,280</span>
              <span class="otg-hero-since">since open</span>
            </div>
          </div>

          <!-- quick stats -->
          <div class="otg-quick">
            <div class="otg-quick-item">
              <div class="otg-quick-num">47</div>
              <div class="otg-quick-cap">invoices</div>
            </div>
            <div class="otg-quick-item">
              <div class="otg-quick-num">12</div>
              <div class="otg-quick-cap">bills</div>
            </div>
            <div class="otg-quick-item">
              <div class="otg-quick-num">3</div>
              <div class="otg-quick-cap">banks</div>
            </div>
          </div>

          <!-- recent feed header -->
          <div class="otg-recent-head">
            <span>Recent</span>
            <span class="otg-recent-meta">live</span>
          </div>

          <!-- recent feed (populated by JS) -->
          <div id="otg-recent" class="otg-recent"></div>

          <!-- bottom tabs -->
          <div class="otg-tabs">
            <div class="otg-tab is-active">
              <span class="otg-tab-icon">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.4">
                  <path d="M2 6 L7 2 L12 6 V12 H8 V8 H6 V12 H2 Z" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
            <div class="otg-tab">
              <span class="otg-tab-icon">
                <svg width="12" height="14" viewBox="0 0 12 14" fill="none" stroke="currentColor" stroke-width="1.4">
                  <rect x="1" y="1" width="10" height="12" rx="1"/>
                  <line x1="3" y1="5" x2="9" y2="5"/>
                  <line x1="3" y1="8" x2="9" y2="8"/>
                  <line x1="3" y1="11" x2="7" y2="11"/>
                </svg>
              </span>
            </div>
            <div class="otg-tab">
              <span class="otg-tab-icon">
                <svg width="14" height="12" viewBox="0 0 14 12" fill="none" stroke="currentColor" stroke-width="1.4">
                  <path d="M2 5 L7 2 L12 5" stroke-linejoin="round"/>
                  <rect x="3" y="5" width="1.5" height="5"/>
                  <rect x="6.25" y="5" width="1.5" height="5"/>
                  <rect x="9.5" y="5" width="1.5" height="5"/>
                  <line x1="1" y1="11" x2="13" y2="11"/>
                </svg>
              </span>
            </div>
            <div class="otg-tab">
              <span class="otg-tab-icon">
                <svg width="14" height="3" viewBox="0 0 14 3" fill="currentColor">
                  <circle cx="2" cy="1.5" r="1.4"/>
                  <circle cx="7" cy="1.5" r="1.4"/>
                  <circle cx="12" cy="1.5" r="1.4"/>
                </svg>
              </span>
            </div>
          </div>

        </div>
      </div>
    </div>

  </div>

  <!-- footer -->
  <div class="otg-footer">
    <div class="otg-foot-row">
      <span class="otg-foot-label">Synced across</span>
      <span class="otg-device-pill"><span class="otg-device-dot"></span> iOS</span>
      <span class="otg-device-pill"><span class="otg-device-dot"></span> Android</span>
      <span class="otg-device-pill"><span class="otg-device-dot"></span> Web</span>
    </div>
    <span id="otg-foot-meta" class="otg-foot-meta">synced just now</span>
  </div>
</div>

<style is:global>
.otg-shell {
  position: relative; width: 100%; max-width: 560px; margin: 0 auto;
  background:
    radial-gradient(120% 80% at 0% 0%, rgba(47, 107, 78, 0.05), transparent 60%),
    radial-gradient(120% 80% at 100% 100%, rgba(180, 83, 9, 0.04), transparent 60%),
    linear-gradient(180deg, #FFFFFF 0%, #FBF8F3 100%);
  border: 1px solid #E8E2D8; border-radius: 14px; overflow: hidden;
  box-shadow: 0 1px 0 rgba(20,15,10,0.04) inset, 0 20px 60px -20px rgba(20,15,10,0.12), 0 4px 14px -4px rgba(20,15,10,0.06);
  font-family: "JetBrains Mono", ui-monospace, "SF Mono", monospace;
  color: #1A1714; isolation: isolate;
}
.otg-grid {
  position: absolute; inset: 0;
  background-image: radial-gradient(rgba(20,15,10,0.07) 1px, transparent 1px);
  background-size: 16px 16px;
  mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, black 50%, transparent 100%);
  pointer-events: none; z-index: 0;
}
.otg-glow { position: absolute; width: 260px; height: 260px; border-radius: 50%; filter: blur(70px); opacity: 0.5; pointer-events: none; z-index: 0; }
.otg-glow--a { top: -100px; left: -80px; background: rgba(47,107,78,0.18); animation: otg-glow-a 9s ease-in-out infinite; }
.otg-glow--b { bottom: -120px; right: -60px; background: rgba(180,83,9,0.10); animation: otg-glow-b 11s ease-in-out infinite; }
@keyframes otg-glow-a { 0%,100% { transform: translate(0,0); } 50% { transform: translate(20px,30px); } }
@keyframes otg-glow-b { 0%,100% { transform: translate(0,0); } 50% { transform: translate(-30px,-20px); } }

.otg-chrome { position: relative; z-index: 2; display: flex; align-items: center; gap: 14px; padding: 14px 18px; border-bottom: 1px solid #E8E2D8; background: linear-gradient(180deg, rgba(20,15,10,0.015), transparent); }
.otg-dots { display: inline-flex; gap: 6px; }
.otg-dots span { width: 10px; height: 10px; border-radius: 50%; }
.otg-dots span:nth-child(1) { background: #E07A5F; }
.otg-dots span:nth-child(2) { background: #E2B33C; }
.otg-dots span:nth-child(3) { background: #2F6B4E; }
.otg-title { flex: 1; text-align: center; font-size: 12px; color: #6B6357; letter-spacing: 0.04em; }
.otg-live { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; color: #2F6B4E; text-transform: uppercase; letter-spacing: 0.12em; font-weight: 600; }
.otg-live-dot { width: 6px; height: 6px; border-radius: 50%; background: #2F6B4E; box-shadow: 0 0 0 0 rgba(47,107,78,0.45); animation: otg-pulse-dot 1.6s ease-out infinite; }
@keyframes otg-pulse-dot { 0% { box-shadow: 0 0 0 0 rgba(47,107,78,0.45); } 100% { box-shadow: 0 0 0 8px rgba(47,107,78,0); } }

.otg-scene { position: relative; z-index: 1; height: 400px; margin: 4px 0; }
.otg-connector { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; }

/* Phone */
.otg-phone { position: absolute; left: 28px; top: 16px; width: 178px; height: 372px; z-index: 3; animation: otg-phone-bob 5s ease-in-out infinite; }
@keyframes otg-phone-bob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
.otg-phone-frame { width: 100%; height: 100%; background: #FFFFFF; border: 1.5px solid #1A1714; border-radius: 28px; padding: 8px; box-shadow: 0 12px 30px -12px rgba(20,15,10,0.22), 0 4px 10px -4px rgba(20,15,10,0.1); position: relative; }
.otg-phone-notch { position: absolute; top: 8px; left: 50%; transform: translateX(-50%); width: 56px; height: 14px; background: #1A1714; border-radius: 0 0 8px 8px; z-index: 2; }
.otg-phone-screen { width: 100%; height: 100%; background: #FBF8F3; border-radius: 22px; overflow: hidden; font-family: "Inter", sans-serif; display: flex; flex-direction: column; }

.otg-status { display: flex; justify-content: space-between; align-items: center; padding: 6px 16px 4px; font-family: "Inter", sans-serif; font-size: 11px; font-weight: 600; color: #1A1714; }
.otg-status-icons { display: inline-flex; gap: 4px; align-items: center; }

.otg-app-nav { display: flex; justify-content: space-between; align-items: center; padding: 10px 12px 6px; }
.otg-app-brand { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; letter-spacing: -0.01em; color: #1A1714; }
.otg-app-mark { width: 18px; height: 18px; border-radius: 5px; background: #1A1714; color: white; display: grid; place-items: center; font-family: "JetBrains Mono", monospace; font-size: 10px; font-weight: 600; }
.otg-app-avatar { width: 22px; height: 22px; border-radius: 50%; background: linear-gradient(135deg, #F0A28A, #6B21A8); color: white; display: grid; place-items: center; font-size: 8.5px; font-weight: 700; letter-spacing: 0; font-family: "JetBrains Mono", monospace; }

.otg-hero { margin: 4px 10px 8px; padding: 10px 12px 12px; background: white; border-radius: 10px; border: 1px solid #E8E2D8; }
.otg-hero-label { font-family: "JetBrains Mono", monospace; font-size: 9px; letter-spacing: 0.14em; color: #A39A8E; font-weight: 500; text-transform: uppercase; }
.otg-hero-val { margin-top: 4px; font-size: 20px; font-weight: 700; color: #1A1714; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; font-family: "Inter", sans-serif; }
.otg-hero-meta { display: inline-flex; gap: 6px; align-items: baseline; margin-top: 2px; }
.otg-hero-up { font-size: 10px; font-weight: 600; color: #2F6B4E; font-variant-numeric: tabular-nums; }
.otg-hero-since { font-size: 9.5px; color: #A39A8E; }

.otg-quick { display: grid; grid-template-columns: repeat(3,1fr); gap: 6px; padding: 0 10px; margin-bottom: 8px; }
.otg-quick-item { background: white; border: 1px solid #E8E2D8; border-radius: 8px; padding: 6px 8px; text-align: center; }
.otg-quick-num { font-size: 13px; font-weight: 700; color: #1A1714; font-variant-numeric: tabular-nums; letter-spacing: -0.01em; }
.otg-quick-cap { font-size: 8.5px; color: #6B6357; letter-spacing: 0.04em; margin-top: 1px; }

.otg-recent-head { display: flex; justify-content: space-between; align-items: baseline; padding: 0 14px 4px; }
.otg-recent-head > span:first-child { font-size: 9.5px; font-family: "JetBrains Mono", monospace; color: #A39A8E; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600; }
.otg-recent-meta { font-size: 9px; color: #2F6B4E; font-weight: 600; letter-spacing: 0.04em; }
.otg-recent { flex: 1; padding: 0 10px 4px; display: flex; flex-direction: column; gap: 4px; overflow: hidden; }
.otg-recent-row { display: grid; grid-template-columns: 12px 1fr auto; gap: 8px; align-items: center; padding: 7px 9px; background: white; border: 1px solid #E8E2D8; border-radius: 6px; font-size: 10.5px; flex-shrink: 0; }
.otg-recent-row.is-fresh { animation: otg-row-in 500ms cubic-bezier(.2,.7,.2,1); }
@keyframes otg-row-in { 0% { opacity: 0; transform: translateY(-6px) scale(0.98); } 100% { opacity: 1; transform: translateY(0) scale(1); } }
.otg-recent-dot { width: 8px; height: 8px; border-radius: 50%; }
.otg-recent-merchant { color: #1A1714; font-weight: 500; letter-spacing: -0.005em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.otg-recent-amt { font-family: "JetBrains Mono", monospace; font-size: 10px; font-weight: 600; color: #1A1714; font-variant-numeric: tabular-nums; }
.otg-recent-amt.is-pos { color: #2F6B4E; }

.otg-tabs { display: grid; grid-template-columns: repeat(4,1fr); border-top: 1px solid #E8E2D8; background: white; padding: 8px 4px 12px; }
.otg-tab { display: grid; place-items: center; color: #A39A8E; font-size: 9px; letter-spacing: 0.04em; transition: color 200ms ease; }
.otg-tab.is-active { color: #2F6B4E; }
.otg-tab-icon { display: inline-flex; align-items: center; justify-content: center; position: relative; }
.otg-tab.is-active .otg-tab-icon::after { content: ""; position: absolute; bottom: -4px; left: 50%; transform: translateX(-50%); width: 4px; height: 4px; border-radius: 50%; background: #2F6B4E; }

/* Laptop */
.otg-laptop { position: absolute; right: 24px; top: 36px; width: 246px; z-index: 2; filter: drop-shadow(0 12px 24px rgba(20,15,10,0.12)); animation: otg-laptop-bob 7s ease-in-out infinite; }
@keyframes otg-laptop-bob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-3px); } }
.otg-laptop::after { content: ""; position: absolute; bottom: -7px; left: -10px; right: -10px; height: 6px; background: linear-gradient(180deg, #D7CFC2 0%, #B5AB99 100%); border-radius: 0 0 8px 8px; }
.otg-laptop::before { content: ""; position: absolute; bottom: -3px; left: 50%; transform: translateX(-50%); width: 50px; height: 4px; background: #1A1714; border-radius: 2px; z-index: 3; }
.otg-laptop-chrome { display: flex; align-items: center; gap: 6px; padding: 8px 12px; background: #F1ECE3; border: 1px solid #E8E2D8; border-bottom: none; border-radius: 8px 8px 0 0; }
.otg-laptop-chrome > span:nth-child(-n+3) { width: 7px; height: 7px; border-radius: 50%; }
.otg-laptop-chrome > span:nth-child(1) { background: #E07A5F; }
.otg-laptop-chrome > span:nth-child(2) { background: #E2B33C; }
.otg-laptop-chrome > span:nth-child(3) { background: #2F6B4E; }
.otg-laptop-title { font-family: "JetBrains Mono", monospace; font-size: 9.5px; color: #6B6357; margin-left: 6px; letter-spacing: 0.04em; }
.otg-laptop-body { background: white; border: 1px solid #E8E2D8; border-top: none; border-radius: 0 0 8px 8px; padding: 12px 14px 10px; font-family: "Inter", sans-serif; }
.otg-laptop-stats { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 10px; }
.otg-laptop-stat-label { font-family: "JetBrains Mono", monospace; font-size: 8.5px; letter-spacing: 0.14em; color: #A39A8E; text-transform: uppercase; font-weight: 600; }
.otg-laptop-stat-val { font-size: 18px; font-weight: 700; color: #1A1714; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; margin-top: 2px; }
.otg-laptop-stat-val.is-fresh { animation: otg-laptop-flash 800ms ease-out; }
@keyframes otg-laptop-flash { 0% { color: #2F6B4E; } 100% { color: #1A1714; } }
.otg-trend-pill { font-family: "Inter", sans-serif; display: inline-flex; align-items: center; gap: 4px; padding: 3px 8px; border-radius: 999px; background: rgba(47,107,78,0.1); color: #2F6B4E; font-size: 10px; font-weight: 700; letter-spacing: 0.02em; }

.otg-laptop-bars { display: grid; grid-template-columns: repeat(10,1fr); gap: 3px; height: 36px; align-items: end; margin-bottom: 8px; }
.otg-bar { background: #2F6B4E; border-radius: 1px; opacity: 0.85; }
.otg-bar:nth-child(-n+5) { opacity: 0.45; background: #1A1714; }
.otg-bar:last-child { background: #2F6B4E; opacity: 1; }

.otg-laptop-foot { display: flex; align-items: center; gap: 8px; font-family: "JetBrains Mono", monospace; font-size: 9px; color: #6B6357; letter-spacing: 0.04em; }
.otg-laptop-recent { color: #6B6357; }
.otg-laptop-dot { width: 4px; height: 4px; border-radius: 50%; background: #2F6B4E; }
.otg-laptop-sync-label { color: #2F6B4E; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }

/* Footer */
.otg-footer { position: relative; z-index: 2; border-top: 1px solid #E8E2D8; background: rgba(20,15,10,0.02); padding: 12px 18px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.otg-foot-row { display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.otg-foot-label { font-size: 11px; color: #6B6357; letter-spacing: 0.04em; }
.otg-device-pill { display: inline-flex; align-items: center; gap: 5px; padding: 3px 9px; border-radius: 999px; background: white; border: 1px solid #E8E2D8; color: #1A1714; font-size: 10.5px; font-weight: 600; letter-spacing: 0.02em; font-family: "Inter", sans-serif; }
.otg-device-dot { width: 5px; height: 5px; border-radius: 50%; background: #2F6B4E; }
.otg-foot-meta { font-size: 10.5px; color: #2F6B4E; font-weight: 600; letter-spacing: 0.06em; animation: otg-foot-fade 3s ease-in-out infinite; }
@keyframes otg-foot-fade { 0%,100% { opacity: 0.6; } 20% { opacity: 1; } }

@media (prefers-reduced-motion: reduce) { .otg-shell * { animation: none !important; } }
</style>

<script>
(function () {
  var root = document.getElementById('otg-root');
  if (!root) return;

  var NEW_TXNS = [
    { merchant: 'Notion Labs',    amount:   -120, dotColor: '#1D4ED8', catLabel: 'Software' },
    { merchant: 'Marker Bros',   amount:  +2400, dotColor: '#2F6B4E', catLabel: 'Sales' },
    { merchant: 'Linear',        amount:    -96, dotColor: '#1D4ED8', catLabel: 'Software' },
    { merchant: 'Halcyon Design',amount:  +3200, dotColor: '#6B21A8', catLabel: 'Pro Services' },
    { merchant: 'Pellet Labs',   amount: +12400, dotColor: '#2F6B4E', catLabel: 'Sales' },
    { merchant: 'Meta Ads',      amount:   -840, dotColor: '#B45309', catLabel: 'Marketing' },
  ];

  var SEED_TXNS = [
    { merchant: 'Cedar & Co.',   amount:  +4280, dotColor: '#2F6B4E' },
    { merchant: 'Stripe payout', amount: +18402, dotColor: '#16898A' },
    { merchant: 'AWS',           amount:   -612, dotColor: '#0E7490' },
  ];

  var BASE_BALANCE  = 24370;
  var SYNC_INTERVAL = 3000;
  var TXN_INTERVAL  = 4500;

  var heroVal      = document.getElementById('otg-hero-val');
  var heroUp       = document.getElementById('otg-hero-up');
  var recentEl     = document.getElementById('otg-recent');
  var laptopVal    = document.getElementById('otg-laptop-val');
  var laptopRecent = document.getElementById('otg-laptop-recent');
  var footMeta     = document.getElementById('otg-foot-meta');
  var animMotion   = document.getElementById('otg-anim-motion');
  var animOpacity  = document.getElementById('otg-anim-opacity');

  var balance       = BASE_BALANCE + 4280;
  var laptopBalance = BASE_BALANCE + 4280;
  var currentTxns   = SEED_TXNS.slice();
  var txnI          = 0;
  var txnCount      = 3;

  function fmtUSD(n) {
    return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }
  function fmtSigned(n) {
    var sign = n < 0 ? '−' : '+';
    return sign + '$' + Math.abs(n).toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
  }

  function renderTxns(list, fresh) {
    recentEl.innerHTML = list.map(function (t, i) {
      var isPos = t.amount > 0;
      return '<div class="otg-recent-row' + (i === 0 && fresh ? ' is-fresh' : '') + '">' +
        '<span class="otg-recent-dot" style="background:' + t.dotColor + '"></span>' +
        '<span class="otg-recent-merchant">' + t.merchant + '</span>' +
        '<span class="otg-recent-amt' + (isPos ? ' is-pos' : '') + '">' + fmtSigned(t.amount) + '</span>' +
        '</div>';
    }).join('');
  }

  function tween(from, duration, onTick) {
    var t0 = performance.now();
    (function tick(now) {
      var p = Math.min(1, (now - t0) / duration);
      var eased = 1 - Math.pow(1 - p, 3);
      onTick(eased, p);
      if (p < 1) requestAnimationFrame(tick);
    })(performance.now());
  }

  function firePacket() {
    if (animMotion && animMotion.beginElement) {
      animMotion.beginElement();
      animOpacity.beginElement();
    }
  }

  function restartAnim(el) {
    el.style.animation = 'none';
    void el.offsetWidth;
    el.style.animation = '';
  }

  // initial render
  renderTxns(currentTxns, false);

  // sync pulse — fires packet + refreshes footer
  setInterval(function () {
    firePacket();
    restartAnim(footMeta);
  }, SYNC_INTERVAL);
  setTimeout(firePacket, 400); // fire once on load

  // transaction loop
  setInterval(function () {
    var t = NEW_TXNS[txnI % NEW_TXNS.length];
    txnI++;
    txnCount++;

    currentTxns = [t, currentTxns[0], currentTxns[1]];
    renderTxns(currentTxns, true);

    var fromBal = balance;
    var toBal   = balance + t.amount;
    balance = toBal;
    tween(fromBal, 700, function (eased) {
      var v = fromBal + (toBal - fromBal) * eased;
      heroVal.textContent = fmtUSD(v);
      heroUp.textContent  = '▲ ' + fmtSigned(v - BASE_BALANCE);
    });

    laptopRecent.textContent = 'Recent · ' + txnCount + ' new';

    // laptop syncs ~1.2s later
    var fromLaptop = laptopBalance;
    setTimeout(function () {
      laptopBalance = toBal;
      tween(fromLaptop, 600, function (eased) {
        laptopVal.textContent = fmtUSD(fromLaptop + (toBal - fromLaptop) * eased);
      });
      laptopVal.classList.remove('is-fresh');
      void laptopVal.offsetWidth;
      laptopVal.classList.add('is-fresh');
      setTimeout(function () { laptopVal.classList.remove('is-fresh'); }, 800);
    }, 1200);
  }, TXN_INTERVAL);
})();
</script>
