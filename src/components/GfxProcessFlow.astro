<style is:global>
  .pf-embed {
    position: relative;
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
    background: linear-gradient(180deg, #FFFFFF 0%, #FBF8F3 100%);
    border: 1px solid #E8E2D8;
    border-radius: 14px;
    overflow: hidden;
    box-shadow:
      0 1px 0 rgba(20,15,10,0.04) inset,
      0 20px 60px -20px rgba(20,15,10,0.12),
      0 4px 14px -4px rgba(20,15,10,0.06);
  }
  .pf-embed svg { display: block; width: 100%; height: auto; }
  .pf-embed text { font-family: "JetBrains Mono", ui-monospace, "SF Mono", monospace; }
  .pf-embed .sans { font-family: "Inter", "Helvetica Neue", Arial, sans-serif; }

  /* ── Live dot ── */
  .pf-live-dot { animation: pf-pulse 1.6s ease-out infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes pf-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

  /* ── Nodes: sequential activation across a 9s cycle ── */
  .pf-node { animation-duration: 9s; animation-iteration-count: infinite; animation-timing-function: ease-in-out; }
  .pf-node--1 { animation-name: pf-n1; }
  .pf-node--2 { animation-name: pf-n2; }
  .pf-node--3 { animation-name: pf-n3; }
  .pf-node--4 { animation-name: pf-n4; }

  @keyframes pf-n1 {
    0%        { fill: #CFE4D8; }
    3%        { fill: #2F6B4E; }
    20%       { fill: #2F6B4E; }
    24%       { fill: #CFE4D8; }
    100%      { fill: #CFE4D8; }
  }
  @keyframes pf-n2 {
    0%, 25%   { fill: #CFE4D8; }
    28%       { fill: #2F6B4E; }
    46%       { fill: #2F6B4E; }
    50%       { fill: #CFE4D8; }
    100%      { fill: #CFE4D8; }
  }
  @keyframes pf-n3 {
    0%, 51%   { fill: #CFE4D8; }
    54%       { fill: #2F6B4E; }
    72%       { fill: #2F6B4E; }
    76%       { fill: #CFE4D8; }
    100%      { fill: #CFE4D8; }
  }
  @keyframes pf-n4 {
    0%, 77%   { fill: #CFE4D8; }
    80%       { fill: #2F6B4E; }
    96%       { fill: #2F6B4E; }
    100%      { fill: #CFE4D8; }
  }

  /* ── Connector flow dots ── */
  .pf-flow { offset-rotate: 0deg; animation-duration: 9s; animation-timing-function: linear; animation-iteration-count: infinite; }
  .pf-flow--1 {
    offset-path: path("M 122 196 L 214 196");
    animation-name: pf-f1;
  }
  .pf-flow--2 {
    offset-path: path("M 274 196 L 366 196");
    animation-name: pf-f2;
  }
  .pf-flow--3 {
    offset-path: path("M 426 196 L 518 196");
    animation-name: pf-f3;
  }

  @keyframes pf-f1 {
    0%        { offset-distance: 0%;   opacity: 0; }
    3%        { offset-distance: 0%;   opacity: 1; }
    21%       { offset-distance: 100%; opacity: 1; }
    24%       { offset-distance: 100%; opacity: 0; }
    100%      { offset-distance: 100%; opacity: 0; }
  }
  @keyframes pf-f2 {
    0%, 28%   { offset-distance: 0%;   opacity: 0; }
    30%       { offset-distance: 0%;   opacity: 1; }
    48%       { offset-distance: 100%; opacity: 1; }
    51%       { offset-distance: 100%; opacity: 0; }
    100%      { offset-distance: 100%; opacity: 0; }
  }
  @keyframes pf-f3 {
    0%, 54%   { offset-distance: 0%;   opacity: 0; }
    56%       { offset-distance: 0%;   opacity: 1; }
    74%       { offset-distance: 100%; opacity: 1; }
    77%       { offset-distance: 100%; opacity: 0; }
    100%      { offset-distance: 100%; opacity: 0; }
  }

  /* ── Ring pings: fire when each node activates ── */
  .pf-ring { transform-box: fill-box; transform-origin: center; animation-duration: 9s; animation-iteration-count: infinite; }
  .pf-ring--1 { animation-name: pf-r1; }
  .pf-ring--2 { animation-name: pf-r2; }
  .pf-ring--3 { animation-name: pf-r3; }
  .pf-ring--4 { animation-name: pf-r4; }

  @keyframes pf-r1 {
    0%        { opacity: 0.7; transform: scale(1); }
    10%       { opacity: 0;   transform: scale(2); }
    100%      { opacity: 0;   transform: scale(2); }
  }
  @keyframes pf-r2 {
    0%, 27%   { opacity: 0;   transform: scale(1); }
    28%       { opacity: 0.7; transform: scale(1); }
    38%       { opacity: 0;   transform: scale(2); }
    100%      { opacity: 0;   transform: scale(2); }
  }
  @keyframes pf-r3 {
    0%, 53%   { opacity: 0;   transform: scale(1); }
    54%       { opacity: 0.7; transform: scale(1); }
    64%       { opacity: 0;   transform: scale(2); }
    100%      { opacity: 0;   transform: scale(2); }
  }
  @keyframes pf-r4 {
    0%, 79%   { opacity: 0;   transform: scale(1); }
    80%       { opacity: 0.7; transform: scale(1); }
    90%       { opacity: 0;   transform: scale(2); }
    100%      { opacity: 0;   transform: scale(2); }
  }

  @media (prefers-reduced-motion: reduce) {
    .pf-embed * { animation: none !important; }
  }
</style>
