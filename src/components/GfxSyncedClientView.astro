<style is:global>
  .sv-embed {
    position: relative;
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
    background: linear-gradient(180deg, #FFFFFF 0%, #FBF8F3 100%);
    border: 1px solid #E8E2D8;
    border-radius: 14px;
    overflow: hidden;
    box-shadow:
      0 1px 0 rgba(20,15,10,0.04) inset,
      0 20px 60px -20px rgba(20,15,10,0.12),
      0 4px 14px -4px rgba(20,15,10,0.06);
  }
  .sv-embed svg { display: block; width: 100%; height: auto; }
  .sv-embed text { font-family: "JetBrains Mono", ui-monospace, "SF Mono", monospace; }
  .sv-embed .sans { font-family: "Inter", "Helvetica Neue", Arial, sans-serif; }

  /* ── Live dot ── */
  .sv-live-dot { animation: sv-pulse 1.6s ease-out infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes sv-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

  /* ── Row highlight: sequential flash across 8s cycle ── */
  .sv-row { animation-duration: 8s; animation-iteration-count: infinite; animation-timing-function: ease-in-out; }
  .sv-row--1 { animation-name: sv-row1; }
  .sv-row--2 { animation-name: sv-row2; }
  .sv-row--3 { animation-name: sv-row3; }
  .sv-row--4 { animation-name: sv-row4; }

  @keyframes sv-row1 {
    0%         { fill: #FFFFFF; stroke: #E8E2D8; }
    3%         { fill: #EAF3EC; stroke: #2F6B4E; }
    20%        { fill: #EAF3EC; stroke: #2F6B4E; }
    24%        { fill: #FFFFFF; stroke: #E8E2D8; }
    100%       { fill: #FFFFFF; stroke: #E8E2D8; }
  }
  @keyframes sv-row2 {
    0%, 25%    { fill: #FFFFFF; stroke: #E8E2D8; }
    28%        { fill: #EAF3EC; stroke: #2F6B4E; }
    45%        { fill: #EAF3EC; stroke: #2F6B4E; }
    49%        { fill: #FFFFFF; stroke: #E8E2D8; }
    100%       { fill: #FFFFFF; stroke: #E8E2D8; }
  }
  @keyframes sv-row3 {
    0%, 50%    { fill: #FFFFFF; stroke: #E8E2D8; }
    53%        { fill: #EAF3EC; stroke: #2F6B4E; }
    70%        { fill: #EAF3EC; stroke: #2F6B4E; }
    74%        { fill: #FFFFFF; stroke: #E8E2D8; }
    100%       { fill: #FFFFFF; stroke: #E8E2D8; }
  }
  @keyframes sv-row4 {
    0%, 75%    { fill: #FFFFFF; stroke: #E8E2D8; }
    78%        { fill: #EAF3EC; stroke: #2F6B4E; }
    95%        { fill: #EAF3EC; stroke: #2F6B4E; }
    99%        { fill: #FFFFFF; stroke: #E8E2D8; }
    100%       { fill: #FFFFFF; stroke: #E8E2D8; }
  }

  /* ── Checkmark draw animation ── */
  .sv-check { stroke-dasharray: 20; animation-duration: 8s; animation-iteration-count: infinite; animation-timing-function: ease-out; }
  .sv-check--1 { animation-name: sv-c1; }
  .sv-check--2 { animation-name: sv-c2; }
  .sv-check--3 { animation-name: sv-c3; }
  .sv-check--4 { animation-name: sv-c4; }

  @keyframes sv-c1 {
    0%         { stroke-dashoffset: 20; opacity: 0; }
    3%         { stroke-dashoffset: 20; opacity: 1; }
    18%        { stroke-dashoffset: 0;  opacity: 1; }
    26%        { stroke-dashoffset: 0;  opacity: 1; }
    29%        { stroke-dashoffset: 20; opacity: 0; }
    100%       { stroke-dashoffset: 20; opacity: 0; }
  }
  @keyframes sv-c2 {
    0%, 27%    { stroke-dashoffset: 20; opacity: 0; }
    30%        { stroke-dashoffset: 20; opacity: 1; }
    44%        { stroke-dashoffset: 0;  opacity: 1; }
    51%        { stroke-dashoffset: 0;  opacity: 1; }
    54%        { stroke-dashoffset: 20; opacity: 0; }
    100%       { stroke-dashoffset: 20; opacity: 0; }
  }
  @keyframes sv-c3 {
    0%, 52%    { stroke-dashoffset: 20; opacity: 0; }
    55%        { stroke-dashoffset: 20; opacity: 1; }
    69%        { stroke-dashoffset: 0;  opacity: 1; }
    76%        { stroke-dashoffset: 0;  opacity: 1; }
    79%        { stroke-dashoffset: 20; opacity: 0; }
    100%       { stroke-dashoffset: 20; opacity: 0; }
  }
  @keyframes sv-c4 {
    0%, 77%    { stroke-dashoffset: 20; opacity: 0; }
    80%        { stroke-dashoffset: 20; opacity: 1; }
    94%        { stroke-dashoffset: 0;  opacity: 1; }
    99%        { stroke-dashoffset: 0;  opacity: 1; }
    100%       { stroke-dashoffset: 20; opacity: 0; }
  }

  /* ── Ring pings: fire when each row activates ── */
  .sv-ring { transform-box: fill-box; transform-origin: center; animation-duration: 8s; animation-iteration-count: infinite; }
  .sv-ring--1 { animation-name: sv-r1; }
  .sv-ring--2 { animation-name: sv-r2; }
  .sv-ring--3 { animation-name: sv-r3; }
  .sv-ring--4 { animation-name: sv-r4; }

  @keyframes sv-r1 {
    0%         { opacity: 0.7; transform: scale(1); }
    10%        { opacity: 0;   transform: scale(2.2); }
    100%       { opacity: 0;   transform: scale(2.2); }
  }
  @keyframes sv-r2 {
    0%, 28%    { opacity: 0;   transform: scale(1); }
    29%        { opacity: 0.7; transform: scale(1); }
    39%        { opacity: 0;   transform: scale(2.2); }
    100%       { opacity: 0;   transform: scale(2.2); }
  }
  @keyframes sv-r3 {
    0%, 53%    { opacity: 0;   transform: scale(1); }
    54%        { opacity: 0.7; transform: scale(1); }
    64%        { opacity: 0;   transform: scale(2.2); }
    100%       { opacity: 0;   transform: scale(2.2); }
  }
  @keyframes sv-r4 {
    0%, 78%    { opacity: 0;   transform: scale(1); }
    79%        { opacity: 0.7; transform: scale(1); }
    89%        { opacity: 0;   transform: scale(2.2); }
    100%       { opacity: 0;   transform: scale(2.2); }
  }

  @media (prefers-reduced-motion: reduce) {
    .sv-embed * { animation: none !important; }
  }
</style>
