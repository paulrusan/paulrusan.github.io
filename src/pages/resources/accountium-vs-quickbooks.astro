        </svg>
      </div>

      <div class="btn-wrap">
        <a href={site.appUrl} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
          TRY NOW
        </a>
      </div>
    </div>
  </section>

  <!-- ── At a Glance Divider ───────────────────────────────── -->
  <section class="b4s2" aria-labelledby="glance-heading">
    <h2 id="glance-heading">At a Glance</h2>
    <p>
      A side-by-side look at where each product stands across the features that
      matter most for a growing business.
    </p>
  </section>

