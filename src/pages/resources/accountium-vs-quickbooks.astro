            <line x1="0" y1="48" x2="560" y2="48" stroke="#E8E2D8"/>
            <circle cx="26" cy="24" r="6" fill="#E07A5F"/>
            <circle cx="44" cy="24" r="6" fill="#E2B33C"/>
            <circle cx="62" cy="24" r="6" fill="#2F6B4E"/>
            <line x1="280" y1="60" x2="280" y2="350" stroke="#E8E2D8"/>
            <text x="140" y="80" text-anchor="middle" font-size="13" font-weight="700" letter-spacing="1.2" fill="#2F6B4E">ACCOUNTIUM</text>
            <text x="140" y="98" text-anchor="middle" class="sans" font-size="13" fill="#6B6357">payroll included</text>
            <rect class="pi-glow" x="52" y="228" width="176" height="72" rx="10" fill="#2F6B4E" opacity="0.5"/>
            <rect x="52" y="228" width="176" height="72" rx="10" fill="#2F6B4E"/>
            <text x="140" y="257" text-anchor="middle" class="sans" font-size="16" font-weight="700" fill="#FFFFFF">$49<tspan font-size="12" font-weight="500">/mo</tspan></text>
            <text x="140" y="276" text-anchor="middle" class="sans" font-size="11.5" fill="#DDEEE3">books + invoicing + payroll</text>
            <text x="140" y="291" text-anchor="middle" class="sans" font-size="11.5" fill="#DDEEE3">+ reporting — all in</text>
            <rect x="58" y="132" width="164" height="86" rx="8" fill="#FFFFFF" stroke="#E8E2D8" stroke-width="1.6"/>
            <text x="140" y="154" text-anchor="middle" class="sans" font-size="12.5" font-weight="600" fill="#1A1714">Books · Invoicing</text>
            <line x1="72" y1="167" x2="208" y2="167" stroke="#E8E2D8"/>
            <text x="140" y="185" text-anchor="middle" class="sans" font-size="12.5" font-weight="600" fill="#1A1714">Payroll</text>
            <line x1="72" y1="197" x2="208" y2="197" stroke="#E8E2D8"/>
            <text x="140" y="211" text-anchor="middle" class="sans" font-size="12.5" font-weight="600" fill="#1A1714">Reporting</text>
            <rect x="80" y="312" width="120" height="24" rx="12" fill="#EAF3EC"/>
            <text x="140" y="328" text-anchor="middle" class="sans" font-size="12.5" font-weight="600" fill="#2F6B4E">single price</text>
            <text x="420" y="80" text-anchor="middle" font-size="13" font-weight="700" letter-spacing="1.2" fill="#6B6357">THE ALTERNATIVE</text>
            <text x="420" y="98" text-anchor="middle" class="sans" font-size="13" fill="#6B6357">payroll is a separate tier</text>
            <rect x="352" y="246" width="136" height="50" rx="8" fill="#F3EFE7" stroke="#D9D2C6" stroke-width="1.6"/>
            <text x="420" y="267" text-anchor="middle" class="sans" font-size="13" font-weight="700" fill="#4A443C">Base plan</text>
            <text x="420" y="284" text-anchor="middle" class="sans" font-size="12" fill="#6B6357">$35/mo</text>
            <rect x="352" y="186" width="136" height="50" rx="8" fill="#FFFFFF" stroke="#D9D2C6" stroke-width="1.6" stroke-dasharray="4 3"/>
            <text x="420" y="207" text-anchor="middle" class="sans" font-size="13" font-weight="700" fill="#1A1714">Payroll tier</text>
            <text x="420" y="224" text-anchor="middle" class="sans" font-size="12" fill="#B45309">+$45/mo</text>
            <circle class="pi-stack-plus" cx="488" cy="236" r="11" fill="#F6E9DE" stroke="#D9D2C6" stroke-width="1.4"/>
            <text class="pi-stack-plus" x="488" y="240" text-anchor="middle" font-size="13" font-weight="700" fill="#B45309">+</text>
            <rect x="352" y="312" width="136" height="24" rx="12" fill="#F6E9DE"/>
            <text class="pi-total-flash" x="420" y="328" text-anchor="middle" class="sans" font-size="12.5" font-weight="700" fill="#B45309">$80/mo total</text>
          </svg>
