          <text x="60" y="208" text-anchor="middle" class="sans" font-size="10" font-weight="600" fill="#1A1714">Payroll</text>
          <rect class="us-chip us-chip--4" x="98" y="279" width="104" height="30" rx="8" fill="#FFFFFF" stroke="#E8E2D8" stroke-width="1.4"/>
          <text x="150" y="298" text-anchor="middle" class="sans" font-size="10" font-weight="600" fill="#1A1714">Reporting</text>
          <rect x="76" y="316" width="148" height="24" rx="12" fill="#EAF3EC"/>
          <text x="150" y="332" text-anchor="middle" class="sans" font-size="10.5" font-weight="600" fill="#2F6B4E">One plan, one price</text>
          <text x="480" y="76" text-anchor="middle" font-size="10.5" font-weight="700" letter-spacing="1.4" fill="#6B6357">THE ALTERNATIVE</text>
