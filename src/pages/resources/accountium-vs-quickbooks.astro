                <td>Higher tiers only</td>
              </tr>
              <tr>
                <td>Third-party app marketplace</td>
                <td>Growing</td>
                <td class="good">750+ integrations</td>
              </tr>
              <tr>
                <td>Accountant/bookkeeper network</td>
                <td>Growing</td>
