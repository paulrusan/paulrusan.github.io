            <text class="us-cost-tag us-cost-tag--2" x="546" y="175" text-anchor="end" font-size="10" font-weight="700" fill="#B45309">+$20</text>
          </g>
          <g class="us-addon us-addon--1">
            <rect x="404" y="196" width="152" height="34" rx="8" fill="#FFFFFF" stroke="#D9D2C6" stroke-width="1.4" stroke-dasharray="4 3"/>
