            <circle cx="4" cy="2" r="4" fill="none" stroke="#9D174D" stroke-width="1.2"/>
            <text class="rt-station-label sans" x="0" y="30" text-anchor="middle" font-size="9.5" font-weight="600" fill="#6B6357">Weekend · overwritten</text>
          </g>
