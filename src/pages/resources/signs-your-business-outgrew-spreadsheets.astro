            <rect x="0" y="0" width="560" height="360" fill="#FBF8F3"/>
          </g>
          <rect x="0.5" y="0.5" width="559" height="359" rx="14" fill="none" stroke="#E8E2D8"/>
          <!-- chrome bar -->
          <line x1="0" y1="48" x2="560" y2="48" stroke="#E8E2D8"/>
          <circle cx="26" cy="24" r="5" fill="#E07A5F"/>
          <circle cx="42" cy="24" r="5" fill="#E2B33C"/>
          <circle cx="58" cy="24" r="5" fill="#2F6B4E"/>
          <text class="rt-title-text" x="280" y="28" text-anchor="middle" font-size="12" fill="#6B6357" letter-spacing="0.5">accountium / audit trail</text>
          <circle class="rt-live-dot" cx="500" cy="24" r="3.5" fill="#2F6B4E"/>
          <text x="512" y="28" font-size="11" fill="#2F6B4E" font-weight="700" letter-spacing="1">LIVE</text>
          <!-- headline -->
          <text class="rt-headline sans" x="280" y="72" text-anchor="middle" font-size="15" font-weight="700" fill="#1A1714">Same weekend. Two different Mondays.</text>
          <!-- TOP LANE: Spreadsheet -->
          <text class="rt-lane-label" x="18" y="102" font-size="10.5" font-weight="700" letter-spacing="1" fill="#9D174D">SPREADSHEET</text>
