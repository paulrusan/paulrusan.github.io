          </g>
          <!-- BOTTOM LANE: Accountium -->
          <text class="rt-lane-label" x="18" y="200" font-size="10.5" font-weight="700" letter-spacing="1" fill="#2F6B4E">ACCOUNTIUM</text>
          <path d="M 90 244 L 470 244" fill="none" stroke="#D7CFC2" stroke-width="1.3" stroke-dasharray="3 5"/>
          <circle class="rt-token rt-token--bottom" r="4.5"/>
          <g transform="translate(90 244)">
            <circle r="16" fill="#FFFFFF" stroke="#1A1714" stroke-width="1.4"/>
            <path d="M-6 -7h12v14h-12z M-3 -3h6M-3 0h6M-3 3h3" stroke="#1A1714" stroke-width="1.1" fill="none"/>
            <text class="rt-station-label sans" x="0" y="30" text-anchor="middle" font-size="9.5" font-weight="600" fill="#6B6357">Fri · edited</text>
          </g>
