---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import GfxPayrollLine from '../../components/GfxPayrollLine.astro';
import GfxPayrollInProduct from '../../components/GfxPayrollInProduct.astro';

const canonicalURL = new URL('/resources/accounting-software-with-payroll-included', site.url).href;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Accounting Software With Payroll Included",
  "description": "Most accounting software treats payroll as an add-on that scales with headcount. Here's what that actually costs — and what \"included\" really means.",
  "author": { "@type": "Organization", "name": "Accountium" },
  "publisher": {
    "@type": "Organization",
    "name": "Accountium",
    "url": site.url,
    "logo": { "@type": "ImageObject", "url": `${site.url}/images/logo.png` }
  },
  "datePublished": "2026-09-20",
  "dateModified": "2026-09-20",
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalURL }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Does Xero include payroll in its plans?",
      "acceptedAnswer": { "@type": "Answer", "text": "No. Xero Payroll, powered by Gusto, is always a separate add-on at $36/month plus $6 per employee or contractor, regardless of which core plan you're on." }
    },
    {
      "@type": "Question",
      "name": "Does QuickBooks Online include payroll?",
      "acceptedAnswer": { "@type": "Answer", "text": "Not in its core plans. QuickBooks Simple Start, Essentials, and Plus don't include payroll — running payroll requires a separate Workforce plan starting at $50/month plus $7 per employee." }
    },
    {
      "@type": "Question",
      "name": "Is payroll really included in Accountium's price, with no per-employee fee?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. Payroll runs on the same plan and price as your bookkeeping — it isn't metered per employee or sold as a separate add-on tier." }
    }
  ]
};
---

<BaseLayout
  title="Accounting Software With Payroll Included"
  description="Most accounting software treats payroll as an add-on that scales with headcount. Here's what that actually costs — and what 'included' really means."
  canonicalURL={canonicalURL}
>

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- ── Page Hero ─────────────────────────────────────────── -->
  <section class="b4s2s1 page-hero" aria-label="Accounting Software With Payroll Included">
    <div class="b4s2s1-inner">
      <span class="label">Accounting</span>
      <h1>Accounting Software With Payroll Included</h1>
      <p class="hero-meta">
        By <strong>Accountium Team</strong> &nbsp;·&nbsp; Updated <strong>September 2026</strong> &nbsp;·&nbsp; &#9201; <strong>5 min read</strong>
      </p>
      <p>
        You don't have a payroll problem. You have a payroll <em>invoice</em> problem.
      </p>
      <p>
        Most accounting software handles the basics of bookkeeping fine. The cost creep
        shows up somewhere else — in the separate plan, the separate per-employee fee,
        the second bill that shows up once you add your first employee. Payroll is
        usually the moment an "affordable" accounting plan stops being affordable.
      </p>

      <GfxPayrollLine />

      <div class="btn-wrap">
        <a href={site.appUrl} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
          TRY NOW
        </a>
      </div>
    </div>
  </section>

  <!-- ── Stacked Add-On Divider ────────────────────────────── -->
  <section class="b4s2" aria-labelledby="stacked-heading">
    <h2 id="stacked-heading">The Stacked Add-On Reality</h2>
    <p>
      Here's what payroll actually costs on top of two of the most popular platforms,
      as of 2026.
    </p>
  </section>

  <!-- ── Stacked Add-On Content ────────────────────────────── -->
  <section class="content-section" aria-label="What payroll costs on top of Xero and QuickBooks">
    <div class="container">
      <div class="feature-block">
        <ul class="criteria-list">
          <li>
            <strong>Xero</strong>
            <p>Payroll is never included in any plan. It's sold separately (powered by Gusto) at $36/month base fee, plus $6 per employee or contractor — on top of whatever your Early, Growing, or Established plan already costs.</p>
          </li>
          <li>
            <strong>QuickBooks Online</strong>
            <p>Payroll isn't part of the core Simple Start, Essentials, or Plus plans at all. To run payroll, you need a separate Workforce plan, starting at $50/month plus $7 per employee for the base tier — and that's before Premium or Elite, which add more per-employee cost for time tracking or expert setup.</p>
          </li>
        </ul>
        <div class="callout callout--tip">
          <strong>Not hidden, just how it's built</strong>
          Neither of these is a trick or unusual — it's simply how both platforms are
          built: bookkeeping is the core product, and payroll is a metered add-on
          stacked on top.
        </div>
      </div>
    </div>
  </section>

  <!-- ── Cost as You Grow Divider ──────────────────────────── -->
  <section class="b4s2" aria-labelledby="grow-heading">
    <h2 id="grow-heading">What That Actually Costs as You Grow</h2>
    <p>
      The math gets more visible the more people you employ, because per-employee
      fees compound with headcount.
    </p>
  </section>

  <!-- ── Cost as You Grow Content ──────────────────────────── -->
  <section class="content-section bg-subtle" aria-label="Payroll cost examples at 6 employees">
    <div class="container">
      <div class="feature-block">
        <ul class="feature-list">
          <li>Xero, 6 employees: $36 + (6 &times; $6) = $72/month for payroll alone</li>
          <li>QuickBooks Workforce Basic, 6 employees: $50 + (6 &times; $7) = $92/month for payroll alone</li>
        </ul>
        <p class="feature-block-body">
          Both figures sit on top of the core plan you're already paying for. Scale to
          15 employees and the payroll line alone climbs to $126/month on Xero, or
          $155/month on QuickBooks Workforce Basic — numbers that keep growing every
          time you hire.
        </p>
      </div>
    </div>
  </section>

  <!-- ── One Plan Divider ──────────────────────────────────── -->
  <section class="b4s2" aria-labelledby="one-plan-heading">
    <h2 id="one-plan-heading">One Plan, Already Included</h2>
    <p>
      Accountium doesn't sell payroll as a separate metered product. It's part of the
      one plan, at the one price — running payroll for your team doesn't trigger a
      second bill or a per-head surcharge as you hire.
    </p>
  </section>

  <!-- ── One Plan Content ──────────────────────────────────── -->
  <section class="content-section" aria-label="Payroll included in the Accountium product">
    <div class="container">
      <div class="feature-block">
        <GfxPayrollInProduct />
        <p class="feature-block-body">
          The price you see is the price you pay, whether you have 2 employees or 20.
          Hours in, CPP, EI, and tax come out the same product you already keep your
          books in — no separate login, no separate bill.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Comparing the Real Cost Divider ───────────────────── -->
  <section class="b4s2" aria-labelledby="compare-heading">
    <h2 id="compare-heading">Comparing the Real Cost</h2>
    <p>
      Base plan plus payroll add-on, side by side at 6 and 15 employees.
    </p>
  </section>

  <!-- ── Comparing the Real Cost Content ───────────────────── -->
  <section class="content-section bg-subtle" aria-label="Cost comparison table">
    <div class="container">
      <div class="feature-block">
        <div class="table-wrap">
          <table class="rate-table">
            <thead>
              <tr>
                <th></th>
                <th>Base Plan</th>
                <th>Payroll</th>
                <th>Total at 6 Employees</th>
                <th>Total at 15 Employees</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Xero (Growing)</td>
                <td class="bad">$46/mo</td>
                <td class="bad">$36 + $6/employee</td>
                <td class="bad">$118/mo</td>
                <td class="bad">$208/mo</td>
              </tr>
              <tr>
                <td>QuickBooks (Essentials + Workforce Basic)</td>
                <td class="bad">$60/mo</td>
                <td class="bad">$50 + $7/employee</td>
                <td class="bad">$152/mo</td>
                <td class="bad">$215/mo</td>
              </tr>
              <tr>
                <td>Accountium</td>
                <td class="good">One price</td>
                <td class="good">Included</td>
                <td class="good">Same price</td>
                <td class="good">Same price</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="feature-block-body table-footnote">
          Competitor pricing shown reflects publicly listed 2026 rates at time of
          writing and is subject to change by the provider.
        </p>
      </div>
    </div>
  </section>

  <!-- ── To Be Fair Divider ────────────────────────────────── -->
  <section class="b4s2" aria-labelledby="fair-heading">
    <h2 id="fair-heading">To Be Fair</h2>
    <p>
      Per-employee payroll pricing isn't a trick — it reflects real, ongoing work.
    </p>
  </section>

  <!-- ── To Be Fair Content ────────────────────────────────── -->
  <section class="content-section" aria-label="A fair look at per-employee payroll pricing">
    <div class="container">
      <div class="feature-block">
        <p class="feature-block-body">
          Running payroll involves real, ongoing costs: tax filing, direct deposit
          processing, compliance updates. Xero and QuickBooks are pricing that work
          explicitly rather than folding it in. The tradeoff is transparency of a
          different kind: you know exactly what payroll costs, it's just billed
          separately and it scales with your team.
        </p>
        <div class="callout callout--tip">
          <strong>Predictability vs. line-item transparency</strong>
          Accountium's approach is to price that cost into the plan itself rather than
          metering it — which means predictability instead of line-item transparency.
          Which model fits better really depends on whether you'd rather see the
          payroll cost broken out, or never think about it at all.
        </div>
      </div>
    </div>
  </section>

  <!-- ── FAQ Divider ───────────────────────────────────────── -->
  <section class="b4s2" aria-labelledby="faq-heading">
    <h2 id="faq-heading">Frequently Asked Questions</h2>
    <p>Common questions about payroll pricing across these platforms.</p>
  </section>

  <!-- ── FAQ Content ──────────────────────────────────────── -->
  <section class="content-section bg-subtle" aria-label="FAQ">
    <div class="container">
      <div class="feature-block">
        <ul class="criteria-list">
          <li>
            <strong>Does Xero include payroll in its plans?</strong>
            <p>No. Xero Payroll, powered by Gusto, is always a separate add-on at $36/month plus $6 per employee or contractor, regardless of which core plan you're on.</p>
          </li>
          <li>
            <strong>Does QuickBooks Online include payroll?</strong>
            <p>Not in its core plans. QuickBooks Simple Start, Essentials, and Plus don't include payroll — running payroll requires a separate Workforce plan starting at $50/month plus $7 per employee.</p>
          </li>
          <li>
            <strong>Is payroll really included in Accountium's price, with no per-employee fee?</strong>
            <p>Yes. Payroll runs on the same plan and price as your bookkeeping — it isn't metered per employee or sold as a separate add-on tier.</p>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ── CTA Divider ───────────────────────────────────────── -->
  <section class="b4s2" aria-labelledby="cta-heading">
    <h2 id="cta-heading">One Price. Payroll Already in It.</h2>
    <p>No add-on tier, no per-employee surcharge — just one plan that includes payroll from day one.</p>
    <div class="btn-wrap">
      <a href={site.appUrl} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
        TRY NOW
      </a>
    </div>
  </section>

  <!-- ── Related Resources Content ────────────────────────── -->
  <section class="content-section" aria-label="Related resources">
    <div class="container">
      <div class="feature-block">
        <ul class="criteria-list">
          <li>
            <strong><a href="/resources/accountium-vs-quickbooks">Accountium vs. QuickBooks Online</a></strong>
            <p>Where the two platforms actually differ, beyond payroll.</p>
          </li>
          <li>
            <strong><a href="/resources/why-we-built-accountium">Why We Built Accountium</a></strong>
            <p>No ads, no upsell popups, no add-on tiers — the reasoning behind the model.</p>
          </li>
        </ul>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero ───────────────────────────────────────────────── */
  .page-hero {
    padding-top: calc(var(--header-height) + var(--space-16));
    background:
      radial-gradient(ellipse 70% 50% at 50% -5%, rgba(8, 145, 178, 0.07) 0%, transparent 60%),
      var(--color-bg);
  }

  .page-hero.b4s2s1::before { display: none; }

  .hero-meta {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }

  /* ── Button spacing wrapper ─────────────────────────────── */
  .btn-wrap {
    display: flex;
    justify-content: center;
    margin: var(--space-8) 0;
  }

  /* ── Content Sections ───────────────────────────────────── */
  .content-section {
    padding: var(--space-16) 0;
  }

  .bg-subtle {
    background: rgba(8, 145, 178, 0.03);
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 var(--space-8);
  }

  /* ── Feature Blocks ─────────────────────────────────────── */
  .feature-block {
    margin-bottom: var(--space-16);
  }

  .feature-block:last-child {
    margin-bottom: 0;
  }

  .feature-block-body {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.8;
    max-width: 66ch;
    margin: 0 auto var(--space-8);
    text-align: center;
  }

  .table-footnote {
    font-size: var(--text-xs);
    font-style: italic;
    margin-top: var(--space-4);
    margin-bottom: 0;
  }

  /* ── Feature list ───────────────────────────────────────── */
  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0 auto var(--space-8);
    max-width: 560px;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .feature-list li {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    font-family: var(--font-mono, monospace);
  }

  .feature-list li::before {
    content: '✓';
    color: var(--color-accent);
    font-weight: 700;
    flex-shrink: 0;
    font-family: var(--font-sans, inherit);
  }

  /* ── Criteria List ──────────────────────────────────────── */
  .criteria-list {
    list-style: none;
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: 0;
  }

  .criteria-list li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-left: var(--space-6);
    position: relative;
  }

  .criteria-list li::before {
    content: "◈";
    position: absolute;
    left: 0;
    top: 2px;
    font-size: var(--text-xs);
    color: var(--color-accent);
  }

  .criteria-list strong {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }

  .criteria-list p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
    max-width: none;
  }

  .criteria-list a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ── b4s2: Accent Section Divider ───────────────────────── */
  .b4s2 {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: var(--space-6);
    padding: var(--space-16) var(--space-8);
    position: relative;
    background: radial-gradient(ellipse at 50% 80%, rgba(8, 145, 178, 0.06) 0%, transparent 50%);
  }

  .b4s2::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: var(--space-16);
    background: linear-gradient(to bottom, transparent, var(--color-accent), transparent);
  }

  .b4s2 h2 {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .b4s2 p {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 58ch;
    margin: 0 auto;
    text-align: center;
  }

  /* ── b4s2s1: Hero Text Section ──────────────────────────── */
  .b4s2s1 {
    padding: var(--space-16) var(--space-8);
    position: relative;
  }

  .b4s2s1::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: var(--space-16);
    background: linear-gradient(to bottom, transparent, var(--color-accent), transparent);
  }

  .b4s2s1-inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .b4s2s1 .label {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-accent);
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .b4s2s1 h1 {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--color-text-primary);
    margin-bottom: var(--space-6);
    text-align: center;
  }

  .b4s2s1 p {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.8;
    max-width: 66ch;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: var(--space-5);
    text-align: center;
  }

  /* ── Callout box ────────────────────────────────────────── */
  .callout {
    max-width: 680px;
    margin: 0 auto;
    background: var(--color-accent-dim);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    padding: var(--space-4) var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-text-primary);
    line-height: 1.65;
    text-align: left;
  }

  .callout strong {
    font-weight: 600;
    color: var(--color-accent);
    display: block;
    margin-bottom: var(--space-1);
  }

  .callout a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ── Comparison table ───────────────────────────────────── */
  .table-wrap {
    overflow-x: auto;
    margin: 0 auto;
    max-width: 780px;
  }

  .rate-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .rate-table th {
    text-align: left;
    font-weight: 600;
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    border-bottom: 2px solid var(--color-border-strong);
    padding: 10px 12px;
    white-space: nowrap;
  }

  .rate-table td {
    padding: 12px;
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .rate-table tr:last-child td { border-bottom: none; }
  .rate-table tr:hover td { background: var(--color-accent-dim); }

  td.good { color: var(--color-green); font-weight: 600; }
  td.bad  { color: #b5493f; font-weight: 600; }
</style>
