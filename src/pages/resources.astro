---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resources } from '../data/resources';
import GfxVsQuickbooks from '../components/GfxVsQuickbooks.astro';
import GfxSpreadsheetSigns from '../components/GfxSpreadsheetSigns.astro';
import GfxClientLedger from '../components/GfxClientLedger.astro';
import GfxCleanVsCluttered from '../components/GfxCleanVsCluttered.astro';

const catCode: Record<string, string> = {
  Accounting:  '1000',
  Bookkeeping: '2000',
  Business:    '3000',
  Technology:  '4000',
  Taxation:    '5000',
};

const catBg: Record<string, string> = {
  Accounting:  '#eaf1fb',
  Bookkeeping: '#f1edfb',
  Business:    '#faf2e8',
  Technology:  '#e6f5f7',
  Taxation:    '#fbeceb',
};

const catFg: Record<string, string> = {
  Accounting:  '#2e6cb0',
  Bookkeeping: '#7a5cc7',
  Business:    '#b5793f',
  Technology:  '#1d94a8',
  Taxation:    '#b5493f',
};

const sorted = [...resources].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

const counts: Record<string, number> = {
  all: resources.length,
  '1000': resources.filter(r => r.category === 'Accounting').length,
  '2000': resources.filter(r => r.category === 'Bookkeeping').length,
  '3000': resources.filter(r => r.category === 'Business').length,
  '4000': resources.filter(r => r.category === 'Technology').length,
  '5000': resources.filter(r => r.category === 'Taxation').length,
};
---

<BaseLayout
  title="Resources"
  description="Guides, product updates, and customer stories for running sharper books — from GST/HST to cash flow to closing your month faster."
>

  <!-- Header -->
  <div class="rp-header">
    <div class="rp-container">
      <div class="rp-eyebrow">Resources</div>
      <h1 class="rp-h1">Field-tested guides for running sharper books.</h1>
      <p class="rp-sub">Compliance guides, product updates, and real customer numbers — filed the way your books are: by account.</p>
    </div>
  </div>

  <!-- Filter tabs -->
  <div class="rp-filters-wrap">
    <div class="rp-container">
      <div class="rp-filters" id="rp-filters">
        <button class="rp-tab active" data-filter="all">All <span class="rp-count">{counts.all}</span></button>
        <button class="rp-tab" data-filter="1000"><span class="rp-code">1000</span> Accounting <span class="rp-count">{counts['1000']}</span></button>
        <button class="rp-tab" data-filter="2000"><span class="rp-code">2000</span> Bookkeeping <span class="rp-count">{counts['2000']}</span></button>
        <button class="rp-tab" data-filter="3000"><span class="rp-code">3000</span> Business <span class="rp-count">{counts['3000']}</span></button>
        <button class="rp-tab" data-filter="4000"><span class="rp-code">4000</span> Technology <span class="rp-count">{counts['4000']}</span></button>
        <button class="rp-tab" data-filter="5000"><span class="rp-code">5000</span> Taxation <span class="rp-count">{counts['5000']}</span></button>
      </div>
    </div>
  </div>

  <!-- Cards -->
  <div class="rp-content">
    <div class="rp-container">
      <div class="rp-cards" id="rp-cards">
        {sorted.map((r) => (
          <a class="rp-card" href={r.href} data-cat={catCode[r.category]}>
            <div class="rp-card-text">
              <span class={`rp-badge cat-${catCode[r.category]}`}>
                {catCode[r.category]} · {r.category}
              </span>
              <h2 class="rp-card-h2">{r.title}</h2>
              <p class="rp-card-excerpt">{r.excerpt}</p>
              <div class="rp-card-meta">
                <span>Accountium Team</span>
                <span class="rp-dot"></span>
                <span>{r.readTime}</span>
              </div>
              <span class="rp-card-link">Read the guide <span class="rp-arrow">→</span></span>
            </div>
            <div class="rp-card-visual">
              {r.id === 12 && <GfxVsQuickbooks />}
              {r.id === 10 && <GfxSpreadsheetSigns />}
              {r.id === 13 && <GfxClientLedger />}
              {r.id === 4 && <GfxCleanVsCluttered />}
              {r.id !== 12 && r.id !== 10 && r.id !== 13 && r.id !== 4 && (
                <div
                  class="rp-card-img"
                  style={`--c-bg: ${catBg[r.category]}; --c-fg: ${catFg[r.category]}`}
                >
                  <span class="rp-card-img-icon">{r.icon}</span>
                  <span class="rp-card-img-code">{catCode[r.category]}</span>
                  <span class="rp-card-img-cat">{r.category}</span>
                </div>
              )}
            </div>
          </a>
        ))}
      </div>

      <!-- Pagination -->
      <nav class="rp-pagination" id="rp-pagination" aria-label="Pagination">
        <button class="rp-pg-arrow" id="rp-prev" aria-label="Previous page">‹</button>
        <div class="rp-page-nums" id="rp-page-nums"></div>
        <button class="rp-pg-arrow" id="rp-next" aria-label="Next page">›</button>
      </nav>
    </div>
  </div>

</BaseLayout>

<style is:global>
  /* Scale down the CSS graphic proportionally to match SVG-based card visuals */
  .rp-card-visual .cvc-embed {
    zoom: 0.62;
    width: calc(100% / 0.62);
    max-width: none;
    margin: 0;
  }

  /* Pagination numbers and ellipsis are JS-created — scoped styles can't reach them */
  .rp-pg-num {
    min-width: 44px;
    height: 52px;
    padding: 0 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: ui-monospace, "JetBrains Mono", "SF Mono", monospace;
    font-size: 1rem;
    font-weight: 500;
    color: #9aabb8;
    background: none !important;
    border: none !important;
    border-radius: 0 !important;
    outline: none !important;
    box-shadow: none !important;
    -webkit-appearance: none;
    appearance: none;
    cursor: pointer;
    letter-spacing: 0.04em;
    transition: color 0.12s;
  }
  .rp-pg-num:focus,
  .rp-pg-num:focus-visible { outline: none !important; box-shadow: none !important; }
  .rp-pg-num:hover { color: #183962; }

  .rp-pg-num.active {
    color: #183962;
    font-weight: 700;
    position: relative;
  }
  .rp-pg-num.active::after {
    content: '';
    position: absolute;
    bottom: 6px;
    left: 50%;
    transform: translateX(-50%);
    width: 16px;
    height: 2px;
    background: #00b89c;
    border-radius: 1px;
  }

  .rp-pg-ellipsis {
    min-width: 32px;
    height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    color: #9aabb8;
    letter-spacing: 0.12em;
    pointer-events: none;
    user-select: none;
  }
</style>

<script>
  const ITEMS_PER_PAGE = 5;
  let page = 1;
  let filter = 'all';

  const cards   = Array.from(document.querySelectorAll<HTMLElement>('.rp-card'));
  const tabs    = Array.from(document.querySelectorAll<HTMLElement>('.rp-tab'));
  const prevBtn = document.getElementById('rp-prev')      as HTMLButtonElement;
  const nextBtn = document.getElementById('rp-next')      as HTMLButtonElement;
  const numsEl  = document.getElementById('rp-page-nums') as HTMLElement;
  const paginEl = document.getElementById('rp-pagination') as HTMLElement;

  function getFiltered(): HTMLElement[] {
    return cards.filter(c => filter === 'all' || c.dataset.cat === filter);
  }

  function pageSequence(current: number, total: number): (number | '...')[] {
    if (total <= 5) return Array.from({ length: total }, (_, i) => i + 1) as number[];
    if (current <= 3) {
      const s: (number | '...')[] = [1, 2, 3];
      if (total > 4) s.push('...');
      s.push(total);
      return s;
    }
    if (current >= total - 2) {
      const s: (number | '...')[] = [1];
      if (total > 4) s.push('...');
      for (let i = Math.max(2, total - 2); i <= total; i++) s.push(i);
      return s;
    }
    return [1, '...', current - 1, current, current + 1, '...', total];
  }

  function render() {
    const filtered   = getFiltered();
    const totalPages = Math.max(1, Math.ceil(filtered.length / ITEMS_PER_PAGE));
    if (page > totalPages) page = totalPages;
    if (page < 1) page = 1;

    const start   = (page - 1) * ITEMS_PER_PAGE;
    const visible = filtered.slice(start, start + ITEMS_PER_PAGE);

    // Use style.display instead of hidden attribute — author-stylesheet display:grid
    // overrides UA-stylesheet [hidden]{display:none} at equal specificity.
    cards.forEach(c => {
      c.style.display = 'none';
      c.classList.remove('rp-card--reverse');
    });
    visible.forEach((c, i) => {
      c.style.display = '';
      if (i % 2 === 1) c.classList.add('rp-card--reverse');
    });

    prevBtn.disabled = page <= 1;
    nextBtn.disabled = page >= totalPages;
    paginEl.hidden   = totalPages <= 1;

    numsEl.innerHTML = '';
    pageSequence(page, totalPages).forEach(p => {
      if (p === '...') {
        const span = document.createElement('span');
        span.className = 'rp-pg-ellipsis';
        span.textContent = '···';
        numsEl.appendChild(span);
      } else {
        const btn = document.createElement('button');
        btn.className = 'rp-pg-num' + (p === page ? ' active' : '');
        btn.textContent = String(p);
        btn.setAttribute('aria-label', `Page ${p}`);
        btn.addEventListener('click', () => { page = p as number; render(); });
        numsEl.appendChild(btn);
      }
    });
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      filter = (tab as HTMLElement & { dataset: { filter: string } }).dataset.filter;
      page = 1;
      render();
    });
  });

  prevBtn.addEventListener('click', () => { page--; render(); });
  nextBtn.addEventListener('click', () => { page++; render(); });

  render();
</script>

<style>
  /* ── Page variables ─────────────────────────────────────── */
  .rp-header,
  .rp-filters-wrap,
  .rp-content {
    --navy:       #183962;
    --teal:       #00b89c;
    --teal-dark:  #00967f;
    --teal-pale:  #e6f9f6;
    --txt-muted:  #5c6c7a;
    --txt-faint:  #9aabb8;
    --bdr:        #dde5eb;
    --bg-white:   #ffffff;

    --c-1000:    #2e6cb0;
    --c-1000-bg: #eaf1fb;
    --c-2000:    #7a5cc7;
    --c-2000-bg: #f1edfb;
    --c-3000:    #b5793f;
    --c-3000-bg: #faf2e8;
    --c-4000:    #1d94a8;
    --c-4000-bg: #e6f5f7;
    --c-5000:    #b5493f;
    --c-5000-bg: #fbeceb;
  }

  /* ── Container ──────────────────────────────────────────── */
  .rp-container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ── Header ─────────────────────────────────────────────── */
  .rp-header {
    padding-top: calc(var(--header-height, 68px) + 48px);
    padding-bottom: 32px;
  }

  .rp-eyebrow {
    font-family: var(--font-mono, monospace);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--teal-dark);
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
  }

  .rp-eyebrow::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--teal);
  }

  .rp-h1 {
    font-size: clamp(1.4rem, 1.9vw, 1.9rem);
    font-weight: 700;
    color: var(--navy);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
  }

  .rp-sub {
    font-size: 0.97rem;
    color: var(--txt-muted);
    line-height: 1.6;
  }

  /* ── Filter tabs ────────────────────────────────────────── */
  .rp-filters-wrap {
    border-bottom: 1px solid var(--bdr);
  }

  .rp-filters {
    display: flex;
    align-items: center;
    gap: 2px;
    flex-wrap: wrap;
  }

  .rp-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 14px;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--txt-muted);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
    line-height: 1;
    white-space: nowrap;
  }

  .rp-tab:hover { color: var(--navy); }

  .rp-tab.active {
    color: var(--navy);
    border-bottom-color: var(--teal);
  }

  .rp-code {
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    color: var(--txt-faint);
    font-weight: 600;
  }

  .rp-count {
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    color: var(--txt-faint);
    background: var(--bg-white);
    border: 1px solid var(--bdr);
    border-radius: 20px;
    padding: 1px 7px;
  }

  .rp-tab.active .rp-count {
    background: var(--teal-pale);
    border-color: var(--teal);
    color: var(--teal-dark);
  }

  /* ── Content area ───────────────────────────────────────── */
  .rp-content {
    padding: 48px 0 96px;
  }

  /* ── Preview cards ──────────────────────────────────────── */
  .rp-cards {
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin-bottom: 52px;
  }

  .rp-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--bg-white);
    border: 1px solid var(--bdr);
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s;
    box-shadow: 0 1px 4px rgba(16, 38, 63, 0.05);
  }

  .rp-card:hover {
    box-shadow: 0 6px 24px rgba(16, 38, 63, 0.10);
  }

  .rp-card--reverse .rp-card-text   { order: 2; }
  .rp-card--reverse .rp-card-visual { order: 1; }

  /* ── Card text column ───────────────────────────────────── */
  .rp-card-text {
    padding: 40px 40px 40px 36px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .rp-badge {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    border-radius: 4px;
    padding: 4px 10px;
    margin-bottom: 16px;
  }

  .rp-card-h2 {
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--navy);
    line-height: 1.22;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  .rp-card-excerpt {
    color: var(--txt-muted);
    font-size: 0.97rem;
    line-height: 1.65;
    margin-bottom: 20px;
    flex-grow: 1;
  }

  .rp-card-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.82rem;
    color: var(--txt-faint);
    margin-bottom: 18px;
  }

  .rp-dot {
    width: 3px;
    height: 3px;
    background: var(--txt-faint);
    border-radius: 50%;
  }

  .rp-card-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-weight: 600;
    color: var(--navy);
    font-size: 0.9rem;
    width: fit-content;
  }

  .rp-arrow { transition: transform 0.15s; }
  .rp-card:hover .rp-arrow { transform: translateX(4px); }

  /* ── Card visual column ─────────────────────────────────── */
  .rp-card-visual {
    background: #f5f2ee;
    padding: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 260px;
  }

  /* Real embed graphics: remove their own margin */
  .rp-card-visual .us-embed,
  .rp-card-visual .rt-embed,
  .rp-card-visual .cl-embed,
  .rp-card-visual .cvc-embed,
  .rp-card-visual .ofv-embed {
    margin: 0;
    max-width: 100%;
  }

  /* Category placeholder */
  .rp-card-img {
    width: 100%;
    aspect-ratio: 640 / 396;
    background: var(--c-bg);
    border-radius: 12px;
    border: 1px solid color-mix(in srgb, var(--c-fg) 18%, transparent);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .rp-card-img-icon {
    font-size: 2.4rem;
    color: var(--c-fg);
    opacity: 0.55;
    line-height: 1;
  }

  .rp-card-img-code {
    font-family: var(--font-mono, monospace);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--c-fg);
    letter-spacing: 0.08em;
  }

  .rp-card-img-cat {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--c-fg);
    opacity: 0.65;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* ── Category badge colours ─────────────────────────────── */
  .cat-1000 { color: var(--c-1000); background: var(--c-1000-bg); }
  .cat-2000 { color: var(--c-2000); background: var(--c-2000-bg); }
  .cat-3000 { color: var(--c-3000); background: var(--c-3000-bg); }
  .cat-4000 { color: var(--c-4000); background: var(--c-4000-bg); }
  .cat-5000 { color: var(--c-5000); background: var(--c-5000-bg); }

  /* ── Pagination ─────────────────────────────────────────── */
  .rp-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
  }

  .rp-pg-arrow {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    line-height: 1;
    color: var(--txt-muted);
    background: none;
    border: 0;
    border-radius: 0;
    outline: none;
    box-shadow: none;
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
    transition: color 0.12s;
    padding: 0;
  }

  .rp-pg-arrow:focus { outline: none; }
  .rp-pg-arrow:focus-visible { outline: none; }

  .rp-pg-arrow:hover:not(:disabled) {
    color: var(--navy);
  }

  .rp-pg-arrow:disabled {
    opacity: 0.25;
    cursor: default;
  }

  .rp-page-nums {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* ── Responsive ─────────────────────────────────────────── */
  @media (max-width: 860px) {
    .rp-card { grid-template-columns: 1fr; }
    .rp-card--reverse .rp-card-text   { order: unset; }
    .rp-card--reverse .rp-card-visual { order: unset; }
    .rp-card-visual { min-height: 200px; }
    .rp-card-text { padding: 28px 24px; }
  }

  @media (max-width: 640px) {
    .rp-tab { padding: 12px 10px; font-size: 0.8rem; }
    .rp-card-h2 { font-size: 1.2rem; }
  }
</style>
