---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resources } from '../data/resources';

const catCode: Record<string, string> = {
  Accounting:  '1000',
  Bookkeeping: '2000',
  Business:    '3000',
  Technology:  '4000',
  Taxation:    '5000',
};

const sorted = [...resources].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

const featured = sorted[0];
const listItems = sorted.slice(1);

const counts: Record<string, number> = {
  all: resources.length,
  '1000': resources.filter(r => r.category === 'Accounting').length,
  '2000': resources.filter(r => r.category === 'Bookkeeping').length,
  '3000': resources.filter(r => r.category === 'Business').length,
  '4000': resources.filter(r => r.category === 'Technology').length,
  '5000': resources.filter(r => r.category === 'Taxation').length,
};
---

<BaseLayout
  title="Resources"
  description="Guides, product updates, and customer stories for running sharper books — from GST/HST to cash flow to closing your month faster."
>

  <!-- Header -->
  <div class="rp-header">
    <div class="rp-container">
      <div class="rp-eyebrow">Resources</div>
      <h1 class="rp-h1">Field-tested guides for running sharper books.</h1>
      <p class="rp-sub">Compliance guides, product updates, and real customer numbers — filed the way your books are: by account.</p>
    </div>
  </div>

  <!-- Filter tabs -->
  <div class="rp-filters-wrap">
    <div class="rp-container">
      <div class="rp-filters" id="rp-filters">
        <button class="rp-tab active" data-filter="all">All <span class="rp-count">{counts.all}</span></button>
        <button class="rp-tab" data-filter="1000"><span class="rp-code">1000</span> Accounting <span class="rp-count">{counts['1000']}</span></button>
        <button class="rp-tab" data-filter="2000"><span class="rp-code">2000</span> Bookkeeping <span class="rp-count">{counts['2000']}</span></button>
        <button class="rp-tab" data-filter="3000"><span class="rp-code">3000</span> Business <span class="rp-count">{counts['3000']}</span></button>
        <button class="rp-tab" data-filter="4000"><span class="rp-code">4000</span> Technology <span class="rp-count">{counts['4000']}</span></button>
        <button class="rp-tab" data-filter="5000"><span class="rp-code">5000</span> Taxation <span class="rp-count">{counts['5000']}</span></button>
      </div>
    </div>
  </div>

  <!-- Content -->
  <div class="rp-content">
    <div class="rp-container">

      <!-- Featured -->
      <a class="rp-featured" href={featured.href} data-cat={catCode[featured.category]}>
        <div class="rp-feat-text">
          <span class="rp-feat-tag">{catCode[featured.category]} · {featured.category}</span>
          <h2 class="rp-feat-h2">{featured.title}</h2>
          <p class="rp-feat-excerpt">{featured.excerpt}</p>
          <div class="rp-feat-meta">
            <span>Accountium Team</span>
            <span class="rp-dot"></span>
            <span>{featured.readTime}</span>
          </div>
          <span class="rp-feat-link">Read the guide <span class="rp-arrow">→</span></span>
        </div>
        <div class="rp-feat-visual">
          <div class="rt-embed">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 396" width="100%" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Accountium as one connected system, versus QuickBooks as a base product with separate bolted-on add-ons">
              <defs><clipPath id="usCardClipFeat"><rect x="0.5" y="0.5" width="639" height="395" rx="14"/></clipPath></defs>
              <g clip-path="url(#usCardClipFeat)"><rect x="0" y="0" width="640" height="396" fill="#FBF8F3"/></g>
              <rect x="0.5" y="0.5" width="639" height="395" rx="14" fill="none" stroke="#E8E2D8"/>
              <line x1="0" y1="48" x2="640" y2="48" stroke="#E8E2D8"/>
              <circle cx="26" cy="24" r="5" fill="#E07A5F"/>
              <circle cx="42" cy="24" r="5" fill="#E2B33C"/>
              <circle cx="58" cy="24" r="5" fill="#2F6B4E"/>
              <text x="320" y="28" text-anchor="middle" font-size="12" fill="#6B6357" letter-spacing="0.5">accountium / how it's built</text>
              <circle class="us-live-dot" cx="580" cy="24" r="3.5" fill="#2F6B4E"/>
              <text x="592" y="28" font-size="11" fill="#2F6B4E" font-weight="700" letter-spacing="1">LIVE</text>
              <line x1="320" y1="60" x2="320" y2="396" stroke="#E8E2D8"/>
              <text x="160" y="84" text-anchor="middle" font-size="11" font-weight="700" letter-spacing="1.2" fill="#2F6B4E">ONE SYSTEM, BUILT TOGETHER</text>
              <circle class="us-hub-ring us-hub-ring--1" cx="150" cy="204" r="38" fill="none" stroke="#2F6B4E" stroke-width="1.2"/>
              <circle class="us-hub-ring us-hub-ring--2" cx="150" cy="204" r="38" fill="none" stroke="#2F6B4E" stroke-width="1.2"/>
              <circle cx="150" cy="204" r="36" fill="#2F6B4E"/>
              <text x="150" y="208" text-anchor="middle" class="sans" font-size="11" font-weight="700" fill="#FFFFFF">Accountium</text>
              <line x1="150" y1="129" x2="150" y2="168" stroke="#CFE4D8" stroke-width="1.5"/>
              <line x1="195" y1="204" x2="186" y2="204" stroke="#CFE4D8" stroke-width="1.5"/>
              <line x1="104" y1="204" x2="114" y2="204" stroke="#CFE4D8" stroke-width="1.5"/>
              <line x1="150" y1="279" x2="150" y2="240" stroke="#CFE4D8" stroke-width="1.5"/>
              <circle class="us-chip-flow us-chip-flow--1" r="3.5" fill="#2F6B4E"/>
              <circle class="us-chip-flow us-chip-flow--2" r="3.5" fill="#2F6B4E"/>
              <circle class="us-chip-flow us-chip-flow--3" r="3.5" fill="#2F6B4E"/>
              <circle class="us-chip-flow us-chip-flow--4" r="3.5" fill="#2F6B4E"/>
              <rect class="us-chip us-chip--1" x="106" y="99" width="88" height="30" rx="8" fill="#FFFFFF" stroke="#E8E2D8" stroke-width="1.4"/>
              <text x="150" y="118" text-anchor="middle" class="sans" font-size="10" font-weight="600" fill="#1A1714">Invoicing</text>
              <rect class="us-chip us-chip--2" x="195" y="189" width="90" height="30" rx="8" fill="#FFFFFF" stroke="#E8E2D8" stroke-width="1.4"/>
              <text x="240" y="208" text-anchor="middle" class="sans" font-size="10" font-weight="600" fill="#1A1714">Banking</text>
              <rect class="us-chip us-chip--3" x="16" y="189" width="88" height="30" rx="8" fill="#FFFFFF" stroke="#E8E2D8" stroke-width="1.4"/>
              <text x="60" y="208" text-anchor="middle" class="sans" font-size="10" font-weight="600" fill="#1A1714">Payroll</text>
              <rect class="us-chip us-chip--4" x="98" y="279" width="104" height="30" rx="8" fill="#FFFFFF" stroke="#E8E2D8" stroke-width="1.4"/>
              <text x="150" y="298" text-anchor="middle" class="sans" font-size="10" font-weight="600" fill="#1A1714">Reporting</text>
              <rect x="76" y="316" width="148" height="24" rx="12" fill="#EAF3EC"/>
              <text x="150" y="332" text-anchor="middle" class="sans" font-size="10.5" font-weight="600" fill="#2F6B4E">One plan, one price</text>
              <text x="480" y="76" text-anchor="middle" font-size="10.5" font-weight="700" letter-spacing="1.4" fill="#6B6357">THE ALTERNATIVE</text>
              <text x="480" y="92" text-anchor="middle" class="sans" font-size="11" fill="#6B6357">base product + separate add-ons</text>
              <g class="us-addon us-addon--3">
                <rect x="404" y="112" width="152" height="34" rx="8" fill="#FFFFFF" stroke="#D9D2C6" stroke-width="1.4" stroke-dasharray="4 3"/>
                <text x="420" y="133" class="sans" font-size="10.5" font-weight="600" fill="#1A1714">Payroll add-on</text>
                <text class="us-cost-tag us-cost-tag--3" x="546" y="133" text-anchor="end" font-size="10" font-weight="700" fill="#B45309">+$45</text>
              </g>
              <g class="us-addon us-addon--2">
                <rect x="404" y="154" width="152" height="34" rx="8" fill="#FFFFFF" stroke="#D9D2C6" stroke-width="1.4" stroke-dasharray="4 3"/>
                <text x="420" y="175" class="sans" font-size="10.5" font-weight="600" fill="#1A1714">Time tracking</text>
                <text class="us-cost-tag us-cost-tag--2" x="546" y="175" text-anchor="end" font-size="10" font-weight="700" fill="#B45309">+$20</text>
              </g>
              <g class="us-addon us-addon--1">
                <rect x="404" y="196" width="152" height="34" rx="8" fill="#FFFFFF" stroke="#D9D2C6" stroke-width="1.4" stroke-dasharray="4 3"/>
                <text x="420" y="217" class="sans" font-size="10.5" font-weight="600" fill="#1A1714">Payments add-on</text>
                <text class="us-cost-tag us-cost-tag--1" x="546" y="217" text-anchor="end" font-size="10" font-weight="700" fill="#B45309">+$25</text>
              </g>
              <rect x="404" y="238" width="152" height="40" rx="8" fill="#F3EFE7" stroke="#D9D2C6" stroke-width="1.6"/>
              <text x="480" y="263" text-anchor="middle" class="sans" font-size="11" font-weight="700" fill="#4A443C">Base plan</text>
              <rect x="404" y="316" width="152" height="24" rx="12" fill="#F6E9DE"/>
              <text x="480" y="332" text-anchor="middle" class="sans" font-size="10.5" font-weight="600" fill="#B45309">Stacked, separate bills</text>
            </svg>
          </div>
        </div>
      </a>

      <!-- Row list -->
      <div class="rp-list" id="rp-list">
        {listItems.map((r) => (
          <a class="rp-row" data-cat={catCode[r.category]} href={r.href}>
            <span class={`rp-badge cat-${catCode[r.category]}`}>{catCode[r.category]}</span>
            <div class="rp-row-body">
              <h3>{r.title}</h3>
              <p>{r.excerpt}</p>
            </div>
            <span class="rp-row-meta">{r.readTime}</span>
            <span class="rp-row-arrow">→</span>
          </a>
        ))}
      </div>

      <!-- Legend -->
      <div class="rp-legend">
        <span><i class="li-1000"></i>1000 Accounting</span>
        <span><i class="li-2000"></i>2000 Bookkeeping</span>
        <span><i class="li-3000"></i>3000 Business</span>
        <span><i class="li-4000"></i>4000 Technology</span>
        <span><i class="li-5000"></i>5000 Taxation</span>
      </div>

    </div>
  </div>

</BaseLayout>

<script>
  const tabs = document.querySelectorAll<HTMLElement>('.rp-tab');
  const rows = document.querySelectorAll<HTMLElement>('.rp-row');
  const featuredEl = document.querySelector<HTMLElement>('.rp-featured');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const filter = (tab as HTMLElement & { dataset: { filter: string } }).dataset.filter;
      if (featuredEl) {
        (featuredEl as HTMLElement).hidden = filter !== 'all' && featuredEl.dataset.cat !== filter;
      }
      rows.forEach(row => {
        (row as HTMLElement).hidden = filter !== 'all' && row.dataset.cat !== filter;
      });
    });
  });
</script>

<style>
  /* ── Page variables ─────────────────────────────────────── */
  .rp-header,
  .rp-filters-wrap,
  .rp-content {
    --navy:       #183962;
    --teal:       #00b89c;
    --teal-dark:  #00967f;
    --teal-pale:  #e6f9f6;
    --txt:        #1a2733;
    --txt-muted:  #5c6c7a;
    --txt-faint:  #9aabb8;
    --bdr:        #dde5eb;
    --bg-white:   #ffffff;
    --bg-row-alt: #f6f9fb;

    --c-1000:    #2e6cb0;
    --c-1000-bg: #eaf1fb;
    --c-2000:    #7a5cc7;
    --c-2000-bg: #f1edfb;
    --c-3000:    #b5793f;
    --c-3000-bg: #faf2e8;
    --c-4000:    #1d94a8;
    --c-4000-bg: #e6f5f7;
    --c-5000:    #b5493f;
    --c-5000-bg: #fbeceb;
  }

  /* ── Container ──────────────────────────────────────────── */
  .rp-container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ── Header ─────────────────────────────────────────────── */
  .rp-header {
    padding-top: calc(var(--header-height, 68px) + 48px);
    padding-bottom: 32px;
  }

  .rp-eyebrow {
    font-family: var(--font-mono, monospace);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--teal-dark);
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
  }

  .rp-eyebrow::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--teal);
  }

  .rp-h1 {
    font-size: clamp(1.4rem, 1.9vw, 1.9rem);
    font-weight: 700;
    color: var(--navy);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
    white-space: nowrap;
  }

  .rp-sub {
    font-size: 0.97rem;
    color: var(--txt-muted);
    line-height: 1.6;
    white-space: nowrap;
  }

  /* ── Filter tabs ────────────────────────────────────────── */
  .rp-filters-wrap {
    border-bottom: 1px solid var(--bdr);
  }

  .rp-filters {
    display: flex;
    align-items: center;
    gap: 2px;
    flex-wrap: wrap;
  }

  .rp-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 14px 14px;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--txt-muted);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
    line-height: 1;
    white-space: nowrap;
  }

  .rp-tab:hover { color: var(--navy); }

  .rp-tab.active {
    color: var(--navy);
    border-bottom-color: var(--teal);
  }

  .rp-code {
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    color: var(--txt-faint);
    font-weight: 600;
  }

  .rp-count {
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    color: var(--txt-faint);
    background: var(--bg-white);
    border: 1px solid var(--bdr);
    border-radius: 20px;
    padding: 1px 7px;
  }

  .rp-tab.active .rp-count {
    background: var(--teal-pale);
    border-color: var(--teal);
    color: var(--teal-dark);
  }

  /* ── Content area ───────────────────────────────────────── */
  .rp-content {
    padding: 40px 0 96px;
  }

  /* ── Featured card ──────────────────────────────────────── */
  .rp-featured {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    background: var(--bg-white);
    border: 1px solid var(--bdr);
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 40px;
    box-shadow: 0 1px 4px rgba(16, 38, 63, 0.05);
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s;
  }

  .rp-featured:hover {
    box-shadow: 0 4px 20px rgba(16, 38, 63, 0.10);
  }

  .rp-feat-text {
    padding: 36px 36px 36px 32px;
    display: flex;
    flex-direction: column;
  }

  .rp-feat-tag {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--teal-dark);
    background: var(--teal-pale);
    border-radius: 4px;
    padding: 4px 10px;
    margin-bottom: 16px;
  }

  .rp-feat-h2 {
    font-size: 1.55rem;
    font-weight: 700;
    color: var(--navy);
    line-height: 1.22;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  .rp-feat-excerpt {
    color: var(--txt-muted);
    font-size: 0.97rem;
    line-height: 1.65;
    margin-bottom: 20px;
    flex-grow: 1;
  }

  .rp-feat-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.82rem;
    color: var(--txt-faint);
    margin-bottom: 18px;
  }

  .rp-dot {
    width: 3px;
    height: 3px;
    background: var(--txt-faint);
    border-radius: 50%;
  }

  .rp-feat-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-weight: 600;
    color: var(--navy);
    font-size: 0.9rem;
    width: fit-content;
  }

  .rp-arrow {
    transition: transform 0.15s;
  }

  .rp-featured:hover .rp-arrow {
    transform: translateX(4px);
  }

  .rp-feat-visual {
    background: #f5f2ee;
    padding: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 240px;
  }

  /* ── rt-embed in featured card ──────────────────────────── */
  .rp-feat-visual .rt-embed {
    margin: 0;
    max-width: 100%;
    box-shadow: 0 4px 20px rgba(20,15,10,0.10);
  }

  .rt-embed {
    position: relative;
    width: 100%;
    max-width: 560px;
    background: linear-gradient(180deg, #FFFFFF 0%, #FBF8F3 100%);
    border: 1px solid #E8E2D8;
    border-radius: 14px;
    overflow: hidden;
    box-shadow:
      0 1px 0 rgba(20,15,10,0.04) inset,
      0 20px 60px -20px rgba(20,15,10,0.12),
      0 4px 14px -4px rgba(20,15,10,0.06);
    font-family: "JetBrains Mono", ui-monospace, "SF Mono", monospace;
    color: #1A1714;
    container-type: inline-size;
    container-name: rt-embed;
  }
  .rt-embed svg { display: block; width: 100%; height: auto; }
  .rt-embed text { font-family: "JetBrains Mono", ui-monospace, monospace; }
  .rt-embed .sans { font-family: "Inter", "Helvetica Neue", Arial, sans-serif; }

  /* live dot */
  .us-live-dot { animation: us-live-pulse 1.6s ease-out infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes us-live-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }

  /* hub sonar rings — hub at cx=150 cy=204 r=36 */
  .us-hub-ring--1 { animation: us-ring-ping 3s ease-out infinite; transform-box: fill-box; transform-origin: center; }
  .us-hub-ring--2 { animation: us-ring-ping 3s ease-out infinite 1.5s; transform-box: fill-box; transform-origin: center; }
  @keyframes us-ring-ping {
    0%   { opacity: 0.7; transform: scale(1); }
    70%  { opacity: 0;   transform: scale(2); }
    100% { opacity: 0;   transform: scale(2); }
  }

  /* chip highlight cycling */
  .us-chip--1 { animation: us-chip-hi 4.8s ease-in-out infinite 0s; }
  .us-chip--2 { animation: us-chip-hi 4.8s ease-in-out infinite 1.2s; }
  .us-chip--3 { animation: us-chip-hi 4.8s ease-in-out infinite 2.4s; }
  .us-chip--4 { animation: us-chip-hi 4.8s ease-in-out infinite 3.6s; }
  @keyframes us-chip-hi {
    0%, 100%  { fill: #FFFFFF; stroke: #E8E2D8; }
    12%, 28%  { fill: #EAF3EC; stroke: #2F6B4E; }
  }

  /* flow dots along spokes — hub top=168, bottom=240, left=114, right=186 */
  .us-chip-flow { offset-rotate: 0deg; }
  .us-chip-flow--1 { offset-path: path("M 150 168 L 150 129"); animation: us-flow-move 4.8s linear infinite 0s; }
  .us-chip-flow--2 { offset-path: path("M 186 204 L 195 204"); animation: us-flow-move 4.8s linear infinite 1.2s; }
  .us-chip-flow--3 { offset-path: path("M 114 204 L 104 204"); animation: us-flow-move 4.8s linear infinite 2.4s; }
  .us-chip-flow--4 { offset-path: path("M 150 240 L 150 279"); animation: us-flow-move 4.8s linear infinite 3.6s; }
  @keyframes us-flow-move {
    0%   { offset-distance: 0%;   opacity: 0; }
    5%   { opacity: 1; }
    22%  { offset-distance: 100%; opacity: 1; }
    28%  { offset-distance: 100%; opacity: 0; }
    100% { offset-distance: 100%; opacity: 0; }
  }

  /* add-on cost tags */
  .us-cost-tag { animation: us-cost-pulse 2.4s ease-in-out infinite; }
  .us-cost-tag--1 { animation-delay: 0s; }
  .us-cost-tag--2 { animation-delay: 0.4s; }
  .us-cost-tag--3 { animation-delay: 0.8s; }
  @keyframes us-cost-pulse { 0%, 100% { opacity: 0.55; } 50% { opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    .rt-embed * { animation: none !important; }
  }

  /* ── Row list ───────────────────────────────────────────── */
  .rp-list {
    background: var(--bg-white);
    border: 1px solid var(--bdr);
    border-radius: 14px;
    overflow: hidden;
  }

  .rp-row {
    display: grid;
    grid-template-columns: 68px 1fr auto 22px;
    align-items: center;
    gap: 18px;
    padding: 18px 22px;
    border-bottom: 1px solid var(--bdr);
    text-decoration: none;
    color: inherit;
    transition: background 0.12s;
  }

  .rp-row:last-child { border-bottom: none; }

  .rp-row:nth-child(even) { background: var(--bg-row-alt); }

  .rp-row:hover { background: var(--teal-pale); }

  .rp-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 8px;
    border-radius: 5px;
    text-align: center;
    width: fit-content;
  }

  .rp-row-body h3 {
    font-size: 0.97rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 3px;
    line-height: 1.3;
  }

  .rp-row-body p {
    font-size: 0.86rem;
    color: var(--txt-muted);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
