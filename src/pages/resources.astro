---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resources } from '../data/resources';

const catCode: Record<string, string> = {
  Accounting:  '1000',
  Bookkeeping: '2000',
  Business:    '3000',
  Technology:  '4000',
  Taxation:    '5000',
};

const sorted = [...resources].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

const featured = sorted[0];
const listItems = sorted.slice(1);

const counts: Record<string, number> = {
  all: resources.length,
  '1000': resources.filter(r => r.category === 'Accounting').length,
  '2000': resources.filter(r => r.category === 'Bookkeeping').length,
  '3000': resources.filter(r => r.category === 'Business').length,
  '4000': resources.filter(r => r.category === 'Technology').length,
  '5000': resources.filter(r => r.category === 'Taxation').length,
};
---

<BaseLayout
  title="Resources"
  description="Guides, product updates, and customer stories for running sharper books — from GST/HST to cash flow to closing your month faster."
>

  <!-- Header -->
  <div class="rp-header">
    <div class="rp-container">
      <div class="rp-eyebrow">Resources</div>
      <h1 class="rp-h1">Field-tested guides for running sharper books.</h1>
      <p class="rp-sub">Compliance guides, product updates, and real customer numbers — filed the way your books are: by account.</p>
    </div>
  </div>

  <!-- Filter tabs -->
  <div class="rp-filters-wrap">
    <div class="rp-container">
      <div class="rp-filters" id="rp-filters">
        <button class="rp-tab active" data-filter="all">All <span class="rp-count">{counts.all}</span></button>
        <button class="rp-tab" data-filter="1000"><span class="rp-code">1000</span> Accounting <span class="rp-count">{counts['1000']}</span></button>
        <button class="rp-tab" data-filter="2000"><span class="rp-code">2000</span> Bookkeeping <span class="rp-count">{counts['2000']}</span></button>
        <button class="rp-tab" data-filter="3000"><span class="rp-code">3000</span> Business <span class="rp-count">{counts['3000']}</span></button>
        <button class="rp-tab" data-filter="4000"><span class="rp-code">4000</span> Technology <span class="rp-count">{counts['4000']}</span></button>
        <button class="rp-tab" data-filter="5000"><span class="rp-code">5000</span> Taxation <span class="rp-count">{counts['5000']}</span></button>
      </div>
    </div>
  </div>

  <!-- Content -->
  <div class="rp-content">
    <div class="rp-container">

      <!-- Featured -->
      <a class="rp-featured" href={featured.href} data-cat={catCode[featured.category]}>
        <div class="rp-feat-text">
          <span class="rp-feat-tag">{catCode[featured.category]} · {featured.category}</span>
          <h2 class="rp-feat-h2">{featured.title}</h2>
          <p class="rp-feat-excerpt">{featured.excerpt}</p>
          <div class="rp-feat-meta">
            <span>Accountium Team</span>
            <span class="rp-dot"></span>
            <span>{featured.readTime}</span>
          </div>
          <span class="rp-feat-link">Read the guide <span class="rp-arrow">→</span></span>
        </div>
        <div class="rp-feat-visual">
          <div class="rt-embed">
            <svg viewBox="0 0 560 360" role="img" aria-label="Accountium — same weekend, two different Mondays: a spreadsheet ends in a mismatch, Accountium ends in sync">
              <defs>
                <clipPath id="rtCardClip">
                  <rect x="0.5" y="0.5" width="559" height="359" rx="14"/>
                </clipPath>
              </defs>
              <g clip-path="url(#rtCardClip)">
                <rect x="0" y="0" width="560" height="360" fill="#FBF8F3"/>
              </g>
              <rect x="0.5" y="0.5" width="559" height="359" rx="14" fill="none" stroke="#E8E2D8"/>
              <line x1="0" y1="48" x2="560" y2="48" stroke="#E8E2D8"/>
              <circle cx="26" cy="24" r="5" fill="#E07A5F"/>
              <circle cx="42" cy="24" r="5" fill="#E2B33C"/>
              <circle cx="58" cy="24" r="5" fill="#2F6B4E"/>
              <text class="rt-title-text" x="280" y="28" text-anchor="middle" font-size="12" fill="#6B6357" letter-spacing="0.5">accountium / audit trail</text>
              <circle class="rt-live-dot" cx="500" cy="24" r="3.5" fill="#2F6B4E"/>
              <text x="512" y="28" font-size="11" fill="#2F6B4E" font-weight="700" letter-spacing="1">LIVE</text>
              <text class="rt-headline sans" x="280" y="72" text-anchor="middle" font-size="15" font-weight="700" fill="#1A1714">Same weekend. Two different Mondays.</text>
              <text class="rt-lane-label" x="18" y="102" font-size="10.5" font-weight="700" letter-spacing="1" fill="#9D174D">SPREADSHEET</text>
              <path d="M 90 128 L 470 128" fill="none" stroke="#D7CFC2" stroke-width="1.3" stroke-dasharray="3 5"/>
              <circle class="rt-token rt-token--top" r="4.5"/>
              <g transform="translate(90 128)">
                <circle r="16" fill="#FFFFFF" stroke="#1A1714" stroke-width="1.4"/>
                <path d="M-6 -7h12v14h-12z M-3 -3h6M-3 0h6M-3 3h3" stroke="#1A1714" stroke-width="1.1" fill="none"/>
                <text class="rt-station-label sans" x="0" y="30" text-anchor="middle" font-size="9.5" font-weight="600" fill="#6B6357">Fri · edited</text>
              </g>
              <g transform="translate(280 128)">
                <circle r="16" fill="#FFFFFF" stroke="#1A1714" stroke-width="1.4"/>
                <circle cx="-4" cy="-2" r="4" fill="none" stroke="#1A1714" stroke-width="1.2"/>
                <circle cx="4" cy="2" r="4" fill="none" stroke="#9D174D" stroke-width="1.2"/>
                <text class="rt-station-label sans" x="0" y="30" text-anchor="middle" font-size="9.5" font-weight="600" fill="#6B6357">Weekend · overwritten</text>
              </g>
              <g transform="translate(470 128)">
                <circle r="16" fill="#FFFFFF" stroke="#9D174D" stroke-width="1.6"/>
                <g class="rt-badge-end">
                  <text class="rt-mismatch-pulse" x="0" y="5" text-anchor="middle" font-size="15" font-weight="800" fill="#9D174D">!</text>
                </g>
                <text class="rt-station-label sans" x="0" y="30" text-anchor="middle" font-size="9.5" font-weight="700" fill="#9D174D">Mon · mismatch</text>
              </g>
              <text class="rt-lane-label" x="18" y="200" font-size="10.5" font-weight="700" letter-spacing="1" fill="#2F6B4E">ACCOUNTIUM</text>
              <path d="M 90 244 L 470 244" fill="none" stroke="#D7CFC2" stroke-width="1.3" stroke-dasharray="3 5"/>
              <circle class="rt-token rt-token--bottom" r="4.5"/>
              <g transform="translate(90 244)">
                <circle r="16" fill="#FFFFFF" stroke="#1A1714" stroke-width="1.4"/>
                <path d="M-6 -7h12v14h-12z M-3 -3h6M-3 0h6M-3 3h3" stroke="#1A1714" stroke-width="1.1" fill="none"/>
                <text class="rt-station-label sans" x="0" y="30" text-anchor="middle" font-size="9.5" font-weight="600" fill="#6B6357">Fri · edited</text>
              </g>
              <g transform="translate(280 244)">
                <circle r="16" fill="#FFFFFF" stroke="#1A1714" stroke-width="1.4"/>
                <circle cx="-4" cy="-2" r="4" fill="none" stroke="#1A1714" stroke-width="1.2"/>
                <circle cx="4" cy="2" r="4" fill="none" stroke="#2F6B4E" stroke-width="1.2"/>
                <text class="rt-station-label sans" x="0" y="30" text-anchor="middle" font-size="9.5" font-weight="600" fill="#6B6357">Weekend · viewed live</text>
              </g>
              <g transform="translate(470 244)">
                <circle r="16" fill="#FFFFFF" stroke="#2F6B4E" stroke-width="1.6"/>
                <g class="rt-badge-end">
                  <path d="M-6 0 L-2 4.5 L6.5 -5" stroke="#2F6B4E" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                </g>
                <text class="rt-station-label sans" x="0" y="30" text-anchor="middle" font-size="9.5" font-weight="700" fill="#2F6B4E">Mon · matched</text>
              </g>
              <line x1="0" y1="292" x2="560" y2="292" stroke="#E8E2D8"/>
              <rect x="0" y="292" width="560" height="68" fill="#14100E" opacity="0.02"/>
              <text class="rt-audit-title" x="18" y="312" font-size="10" font-weight="700" letter-spacing="1" fill="#6B6357">AUDIT TRAIL</text>
              <text class="rt-audit-row rt-audit-row--1 sans" x="18" y="330" font-size="10" fill="#1A1714">
                <tspan fill="#A39A8E">Fri 4:52pm</tspan> · Dana edited Payroll → $24,103
              </text>
              <text class="rt-audit-row rt-audit-row--2 sans" x="18" y="348" font-size="10" fill="#1A1714">
                <tspan fill="#A39A8E">Sat 11:03am</tspan> · Priya viewed Payroll — no conflict
              </text>
            </svg>
          </div>
        </div>
      </a>

      <!-- Row list -->
      <div class="rp-list" id="rp-list">
        {listItems.map((r) => (
          <a class="rp-row" data-cat={catCode[r.category]} href={r.href}>
            <span class={`rp-badge cat-${catCode[r.category]}`}>{catCode[r.category]}</span>
            <div class="rp-row-body">
              <h3>{r.title}</h3>
              <p>{r.excerpt}</p>
            </div>
            <span class="rp-row-meta">{r.readTime}</span>
            <span class="rp-row-arrow">→</span>
          </a>
        ))}
      </div>

      <!-- Legend -->
      <div class="rp-legend">
        <span><i class="li-1000"></i>1000 Accounting</span>
        <span><i class="li-2000"></i>2000 Bookkeeping</span>
        <span><i class="li-3000"></i>3000 Business</span>
        <span><i class="li-4000"></i>4000 Technology</span>
        <span><i class="li-5000"></i>5000 Taxation</span>
      </div>

    </div>
  </div>

</BaseLayout>

<script>
  const tabs = document.querySelectorAll<HTMLElement>('.rp-tab');
  const rows = document.querySelectorAll<HTMLElement>('.rp-row');
  const featuredEl = document.querySelector<HTMLElement>('.rp-featured');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const filter = (tab as HTMLElement & { dataset: { filter: string } }).dataset.filter;
      if (featuredEl) {
        (featuredEl as HTMLElement).hidden = filter !== 'all' && featuredEl.dataset.cat !== filter;
      }
      rows.forEach(row => {
        (row as HTMLElement).hidden = filter !== 'all' && row.dataset.cat !== filter;
      });
    });
  });
</script>

<style>
  /* ── Page variables ─────────────────────────────────────── */
  .rp-header,
  .rp-filters-wrap,
  .rp-content {
    --navy:       #183962;
    --teal:       #00b89c;
    --teal-dark:  #00967f;
    --teal-pale:  #e6f9f6;
    --txt:        #1a2733;
    --txt-muted:  #5c6c7a;
    --txt-faint:  #9aabb8;
    --bdr:        #dde5eb;
    --bg-white:   #ffffff;
    --bg-row-alt: #f6f9fb;

    --c-1000:    #2e6cb0;
    --c-1000-bg: #eaf1fb;
    --c-2000:    #7a5cc7;
    --c-2000-bg: #f1edfb;
    --c-3000:    #b5793f;
    --c-3000-bg: #faf2e8;
    --c-4000:    #1d94a8;
    --c-4000-bg: #e6f5f7;
    --c-5000:    #b5493f;
    --c-5000-bg: #fbeceb;
  }

  /* ── Container ──────────────────────────────────────────── */
  .rp-container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ── Header ─────────────────────────────────────────────── */
  .rp-header {
    padding-top: calc(var(--header-height, 68px) + 48px);
    padding-bottom: 32px;
  }

  .rp-eyebrow {
    font-family: var(--font-mono, monospace);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--teal-dark);
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
  }

  .rp-eyebrow::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--teal);
  }

  .rp-h1 {
    font-size: clamp(1.4rem, 1.9vw, 1.9rem);
    font-weight: 700;
    color: var(--navy);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
    white-space: nowrap;
  }

  .rp-sub {
    font-size: 0.97rem;
    color: var(--txt-muted);
    line-height: 1.6;
    white-space: nowrap;
  }

  /* ── Filter tabs ────────────────────────────────────────── */
  .rp-filters-wrap {
    border-bottom: 1px solid var(--bdr);
  }

  .rp-filters {
    display: flex;
    align-items: center;
    gap: 2px;
    flex-wrap: wrap;
  }

  .rp-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 14px 14px;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--txt-muted);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
    line-height: 1;
    white-space: nowrap;
  }

  .rp-tab:hover { color: var(--navy); }

  .rp-tab.active {
    color: var(--navy);
    border-bottom-color: var(--teal);
  }

  .rp-code {
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    color: var(--txt-faint);
    font-weight: 600;
  }

  .rp-count {
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    color: var(--txt-faint);
    background: var(--bg-white);
    border: 1px solid var(--bdr);
    border-radius: 20px;
    padding: 1px 7px;
  }

  .rp-tab.active .rp-count {
    background: var(--teal-pale);
    border-color: var(--teal);
    color: var(--teal-dark);
  }

  /* ── Content area ───────────────────────────────────────── */
  .rp-content {
    padding: 40px 0 96px;
  }

  /* ── Featured card ──────────────────────────────────────── */
  .rp-featured {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    background: var(--bg-white);
    border: 1px solid var(--bdr);
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 40px;
    box-shadow: 0 1px 4px rgba(16, 38, 63, 0.05);
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s;
  }

  .rp-featured:hover {
    box-shadow: 0 4px 20px rgba(16, 38, 63, 0.10);
  }

  .rp-feat-text {
    padding: 36px 36px 36px 32px;
    display: flex;
    flex-direction: column;
  }

  .rp-feat-tag {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--teal-dark);
    background: var(--teal-pale);
    border-radius: 4px;
    padding: 4px 10px;
    margin-bottom: 16px;
  }

  .rp-feat-h2 {
    font-size: 1.55rem;
    font-weight: 700;
    color: var(--navy);
    line-height: 1.22;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  .rp-feat-excerpt {
    color: var(--txt-muted);
    font-size: 0.97rem;
    line-height: 1.65;
    margin-bottom: 20px;
    flex-grow: 1;
  }

  .rp-feat-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.82rem;
    color: var(--txt-faint);
    margin-bottom: 18px;
  }

  .rp-dot {
    width: 3px;
    height: 3px;
    background: var(--txt-faint);
    border-radius: 50%;
  }

  .rp-feat-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-weight: 600;
    color: var(--navy);
    font-size: 0.9rem;
    width: fit-content;
  }

  .rp-arrow {
    transition: transform 0.15s;
  }

  .rp-featured:hover .rp-arrow {
    transform: translateX(4px);
  }

  .rp-feat-visual {
    background: #f5f2ee;
    padding: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 240px;
  }

  /* ── rt-embed in featured card ──────────────────────────── */
  .rp-feat-visual .rt-embed {
    margin: 0;
    max-width: 100%;
    box-shadow: 0 4px 20px rgba(20,15,10,0.10);
  }

  .rt-embed {
    position: relative;
    width: 100%;
    max-width: 560px;
    background: linear-gradient(180deg, #FFFFFF 0%, #FBF8F3 100%);
    border: 1px solid #E8E2D8;
    border-radius: 14px;
    overflow: hidden;
    box-shadow:
      0 1px 0 rgba(20,15,10,0.04) inset,
      0 20px 60px -20px rgba(20,15,10,0.12),
      0 4px 14px -4px rgba(20,15,10,0.06);
    font-family: "JetBrains Mono", ui-monospace, "SF Mono", monospace;
    color: #1A1714;
    container-type: inline-size;
    container-name: rt-embed;
  }
  .rt-embed svg { display: block; width: 100%; height: auto; }
  .rt-embed text { font-family: "JetBrains Mono", ui-monospace, monospace; }
  .rt-embed .sans { font-family: "Inter", "Helvetica Neue", Arial, sans-serif; }

  .rt-live-dot { animation: rt-pulse-dot 1.6s ease-out infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes rt-pulse-dot { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }

  .rt-token { offset-rotate: 0deg; animation: rt-token-move 4.4s linear infinite; }
  .rt-token--top    { offset-path: path("M 90 128 L 280 128 L 470 128"); fill: #9D174D; }
  .rt-token--bottom { offset-path: path("M 90 244 L 280 244 L 470 244"); fill: #2F6B4E; }
  @keyframes rt-token-move {
    0%   { offset-distance: 0%;   opacity: 0; }
    3%   { opacity: 1; }
    45%  { offset-distance: 100%; opacity: 1; }
    50%  { offset-distance: 100%; opacity: 0; }
    100% { offset-distance: 100%; opacity: 0; }
  }

  .rt-badge-end { animation: rt-badge-pop 4.4s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes rt-badge-pop {
    0%, 43%  { opacity: 0; transform: scale(0.6); }
    47%      { opacity: 1; transform: scale(1.3); }
    53%      { transform: scale(1); }
    92%      { opacity: 1; transform: scale(1); }
    97%      { opacity: 0; transform: scale(0.6); }
    100%     { opacity: 0; transform: scale(0.6); }
  }

  .rt-mismatch-pulse { animation: rt-mismatch 1.4s ease-in-out infinite; }
  @keyframes rt-mismatch { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }

  .rt-audit-row { animation: rt-audit-fade 3.6s ease-in-out infinite; }
  .rt-audit-row--1 { animation-delay: 0s; }
  .rt-audit-row--2 { animation-delay: 0.4s; }
  @keyframes rt-audit-fade { 0%, 100% { opacity: 0.55; } 30% { opacity: 1; } }

  @container rt-embed (max-width: 420px) {
    .rt-title-text { display: none; }
    .rt-headline { font-size: 17px; }
    .rt-lane-label { font-size: 12px; }
    .rt-station-label { font-size: 11.5px; }
    .rt-audit-title { font-size: 11.5px; }
  }
  @container rt-embed (max-width: 340px) {
    .rt-headline { font-size: 19px; }
    .rt-station-label { font-size: 13px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rt-embed * { animation: none !important; }
  }

  /* ── Row list ───────────────────────────────────────────── */
  .rp-list {
    background: var(--bg-white);
    border: 1px solid var(--bdr);
    border-radius: 14px;
    overflow: hidden;
  }

  .rp-row {
    display: grid;
    grid-template-columns: 68px 1fr auto 22px;
    align-items: center;
    gap: 18px;
    padding: 18px 22px;
    border-bottom: 1px solid var(--bdr);
    text-decoration: none;
    color: inherit;
    transition: background 0.12s;
  }

  .rp-row:last-child { border-bottom: none; }

  .rp-row:nth-child(even) { background: var(--bg-row-alt); }

  .rp-row:hover { background: var(--teal-pale); }

  .rp-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 8px;
    border-radius: 5px;
    text-align: center;
    width: fit-content;
  }

  .rp-row-body h3 {
    font-size: 0.97rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 3px;
    line-height: 1.3;
  }

  .rp-row-body p {
    font-size: 0.86rem;
    color: var(--txt-muted);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }

  .rp-row-meta {
    font-family: var(--font-mono, monospace);
    font-size: 0.76rem;
    color: var(--txt-faint);
    white-space: nowrap;
    text-align: right;
  }

  .rp-row-arrow {
    color: var(--txt-faint);
    transition: transform 0.15s, color 0.15s;
    font-size: 1rem;
  }

  .rp-row:hover .rp-row-arrow {
    transform: translateX(3px);
    color: var(--teal-dark);
  }

  /* ── Category badge colours ─────────────────────────────── */
  .cat-1000 { color: var(--c-1000); background: var(--c-1000-bg); }
  .cat-2000 { color: var(--c-2000); background: var(--c-2000-bg); }
  .cat-3000 { color: var(--c-3000); background: var(--c-3000-bg); }
  .cat-4000 { color: var(--c-4000); background: var(--c-4000-bg); }
  .cat-5000 { color: var(--c-5000); background: var(--c-5000-bg); }

  /* ── Legend ─────────────────────────────────────────────── */
  .rp-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 20px;
    font-size: 0.8rem;
    color: var(--txt-faint);
  }

