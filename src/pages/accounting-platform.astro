---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const canonicalURL = new URL('/accounting-platform', site.url).href;
---

<BaseLayout
  title="Accounting Platform"
  description="Explore Accountium's redesigned dashboard — a live financial command centre that unifies your P&L, cash position, and upcoming bills in one real-time view updated every 15 minutes."
  canonicalURL={canonicalURL}
>

  <!-- ── Page Hero ─────────────────────────────────────────── -->
  <section class="b4s2s1 page-hero" aria-label="New Dashboard overview">
    <div class="b4s2s1-inner">
      <span class="label">Technology</span>
      <h1>Accounting Platform</h1>
      <p>
        The redesigned Accountium dashboard is your financial command centre — bringing P&amp;L,
        cash position, and upcoming bills into a single live view refreshed every 15 minutes.
        No more toggling between reports or waiting for end-of-day exports. Every number you need
        is right there, current, and actionable.
      </p>
      <div class="btn-wrap">
        <a href={site.appUrl} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
          TRY NOW
        </a>
      </div>

      <!-- ── Gut Feel vs Data-Driven graphic ── -->
      <div class="gf-embed">
        <svg viewBox="0 0 560 372" role="img" aria-label="Accountium — comparison of guessing from a spreadsheet versus a live forecast with a clear answer">
          <defs>
            <clipPath id="gfCardClip">
              <rect x="0.5" y="0.5" width="559" height="371" rx="14"/>
            </clipPath>
          </defs>
          <g clip-path="url(#gfCardClip)">
            <rect x="0" y="0" width="560" height="372" fill="#FBF8F3"/>
          </g>
          <rect x="0.5" y="0.5" width="559" height="371" rx="14" fill="none" stroke="#E8E2D8"/>
          <line x1="0" y1="48" x2="560" y2="48" stroke="#E8E2D8"/>
          <circle cx="26" cy="24" r="5" fill="#E07A5F"/>
          <circle cx="42" cy="24" r="5" fill="#E2B33C"/>
          <circle cx="58" cy="24" r="5" fill="#2F6B4E"/>
          <text class="gf-title-text" x="280" y="28" text-anchor="middle" font-size="12" fill="#6B6357" letter-spacing="0.5">accountium / forecast</text>
          <circle class="gf-live-dot" cx="500" cy="24" r="3.5" fill="#2F6B4E"/>
          <text x="512" y="28" font-size="11" fill="#2F6B4E" font-weight="700" letter-spacing="1">LIVE</text>
          <text class="gf-panel-label" x="136" y="68" text-anchor="middle" font-size="10.5" font-weight="700" letter-spacing="1.4" fill="#9D174D">GUT FEEL</text>
          <text class="gf-panel-label" x="424" y="68" text-anchor="middle" font-size="10.5" font-weight="700" letter-spacing="1.4" fill="#2F6B4E">DATA-DRIVEN</text>
          <rect x="16" y="80" width="240" height="220" rx="10" fill="#FFFFFF" stroke="#E8E2D8"/>
          <text x="30" y="106" class="sans" font-size="11" font-weight="600" fill="#1A1714">"Can we afford to hire?"</text>
          <g transform="translate(34 200)">
            <path class="gf-guess-line" d="M0 40 C 20 30, 40 46, 60 20 C 80 -2, 100 34, 120 10 C 140 -8, 160 24, 180 6"
              fill="none" stroke="#9D174D" stroke-width="2" stroke-linecap="round" opacity="0.55"/>
          </g>
          <text class="gf-question gf-question--1 sans" x="70" y="150" font-size="20" font-weight="700" fill="#9D174D">?</text>
          <text class="gf-question gf-question--2 sans" x="150" y="130" font-size="26" font-weight="700" fill="#9D174D">?</text>
          <text class="gf-question gf-question--3 sans" x="200" y="170" font-size="16" font-weight="700" fill="#9D174D">?</text>
          <text class="gf-panel-caption sans" x="30" y="266" font-size="10.5" fill="#6B6357">"I think we're doing okay</text>
          <text class="gf-panel-caption sans" x="30" y="280" font-size="10.5" fill="#6B6357">this quarter…"</text>
          <g transform="translate(280 190)">
            <path class="gf-chevron gf-chevron--1" d="M-6 -8 L0 0 L-6 8" fill="none" stroke="#2F6B4E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path class="gf-chevron gf-chevron--2" d="M0 -8 L6 0 L0 8" fill="none" stroke="#2F6B4E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path class="gf-chevron gf-chevron--3" d="M6 -8 L12 0 L6 8" fill="none" stroke="#2F6B4E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </g>
          <rect x="304" y="80" width="240" height="220" rx="10" fill="#FFFFFF" stroke="#E8E2D8"/>
          <text x="318" y="106" class="sans" font-size="11" font-weight="600" fill="#1A1714">Margin trend · Q2 forecast</text>
          <g transform="translate(318 190)">
            <rect x="0"   y="26" width="14" height="14" fill="#1A1714" opacity="0.5"/>
            <rect x="20"  y="18" width="14" height="22" fill="#1A1714" opacity="0.5"/>
            <rect x="40"  y="10" width="14" height="30" fill="#1A1714" opacity="0.5"/>
            <rect x="60"  y="2"  width="14" height="38" fill="#2F6B4E"/>
            <rect x="80"  y="-6" width="14" height="46" fill="#2F6B4E"/>
            <rect x="100" y="-14" width="14" height="54" fill="#2F6B4E"/>
            <path class="gf-forecast-line" d="M7 33 L27 29 L47 25 L67 21 L87 13, 109 -3"
              fill="none" stroke="#2F6B4E" stroke-width="2" stroke-linecap="round"/>
            <circle class="gf-forecast-dot" r="4" fill="#2F6B4E"/>
          </g>
          <g transform="translate(424 262)">
            <rect class="gf-answer-pill" x="-96" y="-14" width="192" height="28" rx="14" fill="#2F6B4E" fill-opacity="0.1" stroke="#2F6B4E" stroke-opacity="0.3"/>
            <text class="gf-answer-pill sans" x="0" y="5" text-anchor="middle" font-size="11" font-weight="700" fill="#2F6B4E">Yes — margin holds through Q2</text>
          </g>
          <text class="gf-panel-caption sans" x="318" y="292" font-size="10.5" fill="#2F6B4E" font-weight="600">Answered in minutes, not days</text>
          <line x1="0" y1="320" x2="560" y2="320" stroke="#E8E2D8"/>
          <rect x="0" y="320" width="560" height="52" fill="#14100E" opacity="0.02"/>
          <text x="280" y="342" text-anchor="middle" class="sans" font-size="12" font-weight="600" fill="#1A1714">Stop guessing — see where your business is actually headed</text>
          <g transform="translate(216 356)">
            <circle class="gf-foot-dot" r="3.5" fill="#2F6B4E"/>
          </g>
          <text class="gf-foot-text" x="228" y="360" font-size="10.5" fill="#2F6B4E" font-weight="600">Live dashboards · always current</text>
        </svg>
      </div>
    </div>
  </section>

  <!-- ── H2 Section 1 Divider ──────────────────────────────── -->
  <section class="b4s2" aria-labelledby="whats-new-heading">
    <h2 id="whats-new-heading">What's New in the Accountium Dashboard</h2>
    <p>
      The redesign focuses on speed, clarity, and immediate value — surfacing the metrics
      that matter most before you even finish your morning coffee.
    </p>
  </section>

  <!-- ── H2 Section 1 Content ──────────────────────────────── -->
  <section class="content-section bg-subtle" aria-label="New dashboard features">
    <div class="container">

      <!-- H3: Live Financial Overview -->
      <div class="feature-block">
        <h3 class="feature-block-heading">Live Financial Overview</h3>
        <p class="feature-block-body">
          Your P&amp;L, revenue, and expenses are pulled directly from connected bank accounts
          and transaction feeds. The overview card updates every 15 minutes so your numbers
          are always within one quarter-hour of reality — not yesterday's batch export.
        </p>
        <ul class="feature-list">
          <li>Revenue vs. expenses at a glance</li>
          <li>Month-to-date and year-to-date toggle</li>
          <li>Colour-coded variance indicators</li>
          <li>One-click drill-down to transactions</li>
        </ul>
      </div>

      <!-- H3: Cash Flow Pulse -->
      <div class="feature-block">
        <h3 class="feature-block-heading">Cash Flow Pulse</h3>
        <p class="feature-block-body">
          A rolling 30-day cash flow chart replaces the static balance view. See exactly
          when money is expected to arrive, when bills are due, and where your runway
          stands — all without opening a separate report.
        </p>
        <ul class="criteria-list">
          <li>
            <strong>Rolling 30-Day View</strong>
            <p>Projected inflows and outflows charted day-by-day so you can spot shortfalls before they happen.</p>
          </li>
          <li>
            <strong>15-Minute Refresh</strong>
            <p>Live bank feeds update automatically — no manual sync required, no stale data to second-guess.</p>
          </li>
          <li>
            <strong>Low-Balance Alerts</strong>
            <p>Set a threshold and receive an in-app notification the moment your balance dips below it.</p>
          </li>
        </ul>
      </div>

      <!-- H3: Bills & Receivables at a Glance -->
      <div class="feature-block">
        <h3 class="feature-block-heading">Bills &amp; Receivables at a Glance</h3>
        <p class="feature-block-body">
          Overdue invoices and upcoming vendor payments surface directly on the dashboard,
          ranked by due date and amount. Chase what matters first; never miss a payment deadline again.
        </p>
        <ul class="criteria-list">
          <li>
            <strong>Overdue Invoices</strong>
            <p>Flagged in red with the number of days past due and a one-click send-reminder action.</p>
          </li>
          <li>
            <strong>Upcoming Bills</strong>
            <p>Vendor payments due in the next 14 days listed with amounts and payment-status badges.</p>
          </li>
          <li>
            <strong>Aged Receivables Summary</strong>
            <p>A compact aging breakdown (0–30, 31–60, 60+ days) gives your collections picture instantly.</p>
          </li>
        </ul>
      </div>

      <!-- H3: Customisable Widgets -->
      <div class="feature-block">
        <h3 class="feature-block-heading">Customisable Widgets</h3>
        <p class="feature-block-body">
          Drag, resize, and reorder every card on the dashboard to match how your team thinks.
          Pin the metrics your business cares about most — hide everything else.
        </p>
        <ul class="criteria-list">
          <li>
            <strong>Drag-and-Drop Layout</strong>
            <p>Rearrange widgets in seconds with a simple drag — no settings menus or code required.</p>
          </li>
          <li>
            <strong>Role-Based Views</strong>
            <p>Owners, bookkeepers, and accountants each get a default view tuned to their priorities.</p>
          </li>
          <li>
            <strong>Saved Presets</strong>
            <p>Save your favourite layouts and switch between them with one click during busy periods.</p>
          </li>
        </ul>
      </div>

    </div>
  </section>

  <!-- ── Accent Divider ────────────────────────────────────── -->
  <div class="accent-rule" aria-hidden="true"></div>

  <!-- ── Try Now CTA between sections ─────────────────────── -->
  <section class="mid-cta" aria-label="Try the dashboard">
    <!-- ── Anywhere Access graphic ── -->
    <div class="acs-embed">
      <svg viewBox="0 0 560 330" role="img" aria-label="Accountium — access your books from any device, always in sync">
        <defs>
          <radialGradient id="acsCloudGlow" cx="50%" cy="45%" r="60%">
            <stop offset="0%" stop-color="#2F6B4E" stop-opacity="0.14"/>
            <stop offset="100%" stop-color="#2F6B4E" stop-opacity="0"/>
          </radialGradient>
          <radialGradient id="acsBgGlowA" cx="0%" cy="0%" r="60%">
            <stop offset="0%" stop-color="#2F6B4E" stop-opacity="0.10"/>
            <stop offset="100%" stop-color="#2F6B4E" stop-opacity="0"/>
          </radialGradient>
          <radialGradient id="acsBgGlowB" cx="100%" cy="100%" r="60%">
            <stop offset="0%" stop-color="#1D4ED8" stop-opacity="0.07"/>
            <stop offset="100%" stop-color="#1D4ED8" stop-opacity="0"/>
          </radialGradient>
          <clipPath id="acsCardClip">
            <rect x="0.5" y="0.5" width="559" height="329" rx="14"/>
          </clipPath>
        </defs>
        <g clip-path="url(#acsCardClip)">
          <rect x="0" y="0" width="560" height="330" fill="url(#acsBgGlowA)"/>
          <rect x="0" y="0" width="560" height="330" fill="url(#acsBgGlowB)"/>
        </g>
        <rect x="0.5" y="0.5" width="559" height="329" rx="14" fill="none" stroke="#E8E2D8"/>
        <line x1="0" y1="48" x2="560" y2="48" stroke="#E8E2D8"/>
        <circle cx="26" cy="24" r="5" fill="#E07A5F"/>
        <circle cx="42" cy="24" r="5" fill="#E2B33C"/>
        <circle cx="58" cy="24" r="5" fill="#2F6B4E"/>
        <text class="acs-title-text" x="280" y="28" text-anchor="middle" font-size="12" fill="#6B6357" letter-spacing="0.5">accountium / anywhere</text>
        <circle class="acs-live-dot" cx="500" cy="24" r="3.5" fill="#2F6B4E"/>
        <text x="512" y="28" font-size="11" fill="#2F6B4E" font-weight="700" letter-spacing="1">LIVE</text>
        <circle cx="280" cy="150" r="120" fill="url(#acsCloudGlow)"/>
        <circle class="acs-ring acs-ring--1" cx="280" cy="150" r="70" fill="none" stroke="#2F6B4E" stroke-width="1"/>
        <circle class="acs-ring acs-ring--2" cx="280" cy="150" r="70" fill="none" stroke="#2F6B4E" stroke-width="1"/>
        <path d="M 84 167  Q 160 160, 280 150" fill="none" stroke="#D7CFC2" stroke-width="1.3" stroke-dasharray="3 5"/>
        <path d="M 484 138 Q 380 145, 280 150" fill="none" stroke="#D7CFC2" stroke-width="1.3" stroke-dasharray="3 5"/>
        <path d="M 280 225 Q 280 190, 280 150" fill="none" stroke="#D7CFC2" stroke-width="1.3" stroke-dasharray="3 5"/>
        <circle class="acs-packet acs-packet--phone"  r="4.5" fill="#6B21A8"/>
        <circle class="acs-packet acs-packet--tablet" r="4.5" fill="#1D4ED8"/>
        <circle class="acs-packet acs-packet--laptop" r="4.5" fill="#2F6B4E"/>
        <!-- cloud -->
        <g transform="translate(218 110)">
          <path d="M28 58 C10 58 0 46 0 34 C0 22 10 12 22 12 C25 2 36 -4 48 0 C56 -6 70 -4 76 6 C92 4 108 14 108 30 C108 44 96 58 80 58 Z"
            fill="#FFFFFF" stroke="#1A1714" stroke-width="1.6"/>
          <g class="acs-cloud-glyph" transform="translate(54 26)">
            <path d="M-9 0a9 9 0 0 1 16.8-4.2M9 0a9 9 0 0 1-16.8 4.2" stroke="#2F6B4E" stroke-width="1.8" stroke-linecap="round" fill="none"/>
            <path d="M6.6 -6.6v4.8H2" stroke="#2F6B4E" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            <path d="M-6.6 6.6v-4.8H-2" stroke="#2F6B4E" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </g>
        </g>
        <!-- Phone -->
        <g>
          <circle class="acs-node-glow acs-node-glow--phone" cx="84" cy="167" r="34" fill="#6B21A8"/>
          <rect x="64" y="130" width="40" height="74" rx="9" fill="#1A1714"/>
          <rect x="68" y="138" width="32" height="52" rx="2" fill="#FFFFFF"/>
          <rect class="acs-screen-flash acs-screen-flash--phone" x="68" y="138" width="32" height="52" rx="2" fill="#6B21A8"/>
          <rect x="72" y="144" width="24" height="4" rx="1.5" fill="#E8E2D8"/>
          <rect x="72" y="152" width="16" height="4" rx="1.5" fill="#6B21A8"/>
          <rect x="72" y="160" width="20" height="14" rx="1.5" fill="#F3EFE7"/>
          <rect x="75" y="169" width="4" height="4" fill="#6B21A8"/>
          <rect x="81" y="165" width="4" height="8" fill="#6B21A8"/>
          <rect x="87" y="162" width="4" height="11" fill="#6B21A8"/>
          <rect x="72" y="178" width="24" height="4" rx="1.5" fill="#E8E2D8"/>
          <rect x="80" y="197" width="8" height="2.5" rx="1.25" fill="#4A443C"/>
          <rect x="46" y="211" width="76" height="18" rx="9" fill="#FFFFFF" stroke="#E8E2D8"/>
          <text x="84" y="223" text-anchor="middle" class="sans" font-size="10.5" font-weight="600" fill="#1A1714">Phone</text>
        </g>
        <!-- Tablet -->
        <g>
          <circle class="acs-node-glow acs-node-glow--tablet" cx="484" cy="138" r="42" fill="#1D4ED8"/>
          <rect x="452" y="96" width="64" height="84" rx="10" fill="#1A1714"/>
          <rect x="458" y="104" width="52" height="68" rx="2" fill="#FFFFFF"/>
          <rect class="acs-screen-flash acs-screen-flash--tablet" x="458" y="104" width="52" height="68" rx="2" fill="#1D4ED8"/>
          <rect x="463" y="110" width="34" height="5" rx="2" fill="#E8E2D8"/>
          <rect x="463" y="121" width="22" height="5" rx="2" fill="#1D4ED8"/>
          <rect x="463" y="132" width="42" height="24" rx="2" fill="#F3EFE7"/>
          <rect x="468" y="145" width="5" height="8" fill="#1D4ED8"/>
          <rect x="476" y="139" width="5" height="14" fill="#1D4ED8"/>
          <rect x="484" y="135" width="5" height="18" fill="#1D4ED8"/>
          <rect x="492" y="142" width="5" height="11" fill="#1D4ED8"/>
          <rect x="463" y="161" width="42" height="5" rx="2" fill="#E8E2D8"/>
          <circle cx="484" cy="176" r="2" fill="#4A443C"/>
          <rect x="440" y="190" width="88" height="18" rx="9" fill="#FFFFFF" stroke="#E8E2D8"/>
          <text x="484" y="202" text-anchor="middle" class="sans" font-size="10.5" font-weight="600" fill="#1A1714">Tablet</text>
        </g>
        <!-- Laptop -->
        <g>
          <circle class="acs-node-glow acs-node-glow--laptop" cx="280" cy="225" r="46" fill="#2F6B4E"/>
