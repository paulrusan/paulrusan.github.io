---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const canonicalURL = new URL('/accounting-software', site.url).href;
---

<BaseLayout
  title="Accounting Software Online"
  description="Conquer your finances with Accountium's online accounting software. Streamline invoicing, expense tracking, bank reconciliation, and financial reporting — anytime, anywhere."
  canonicalURL={canonicalURL}
>

  <!-- ── Page Hero ─────────────────────────────────────────── -->
  <section class="b4s2s1 page-hero" aria-label="Accounting Software overview">
    <div class="b4s2s1-inner">
      <span class="label">Accounting</span>
      <h1>Accounting Software Online</h1>
      <p>
        A guide to the best online accounting software — powerful, user-friendly, and accessible
        from any device, anytime, anywhere. In today's digital age, there's no need to be chained
        to a desk drowning in receipts and spreadsheets.
      </p>
      <p>
        For businesses of all sizes, managing finances can be a daunting task — but with the advent
        of cloud accounting, the process has never been easier.
      </p>
      <div class="btn-wrap">
        <a href={site.appUrl} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
          TRY NOW
        </a>
      </div>

      <!-- ── Dashboard Overview graphic ── -->
      <div class="do-embed">
        <svg viewBox="0 0 560 440" role="img" aria-label="Accountium — dashboard overview: balance, invoices, bills, bank feeds, and categorized activity">
          <defs>
            <radialGradient id="doBgGlowA" cx="0%" cy="0%" r="60%">
              <stop offset="0%" stop-color="#2F6B4E" stop-opacity="0.09"/>
              <stop offset="100%" stop-color="#2F6B4E" stop-opacity="0"/>
            </radialGradient>
            <radialGradient id="doBgGlowB" cx="100%" cy="100%" r="60%">
              <stop offset="0%" stop-color="#B45309" stop-opacity="0.06"/>
              <stop offset="100%" stop-color="#B45309" stop-opacity="0"/>
            </radialGradient>
            <clipPath id="doCardClip">
              <rect x="0.5" y="0.5" width="559" height="439" rx="14"/>
            </clipPath>
          </defs>

          <!-- card background -->
          <g clip-path="url(#doCardClip)">
            <rect class="do-glow-a" x="-60" y="-60" width="260" height="260" fill="url(#doBgGlowA)"/>
            <rect class="do-glow-b" x="360" y="220" width="260" height="260" fill="url(#doBgGlowB)"/>
          </g>
          <rect x="0.5" y="0.5" width="559" height="439" rx="14" fill="none" stroke="#E8E2D8"/>

          <!-- chrome bar -->
          <line x1="0" y1="48" x2="560" y2="48" stroke="#E8E2D8"/>
          <circle cx="26" cy="24" r="5" fill="#E07A5F"/>
          <circle cx="42" cy="24" r="5" fill="#E2B33C"/>
          <circle cx="58" cy="24" r="5" fill="#2F6B4E"/>
          <text class="do-title-text" x="280" y="28" text-anchor="middle" font-size="12" fill="#6B6357" letter-spacing="0.5">accountium / dashboard</text>
          <circle class="do-live-dot" cx="500" cy="24" r="3.5" fill="#2F6B4E"/>
          <text x="512" y="28" font-size="11" fill="#2F6B4E" font-weight="700" letter-spacing="1">LIVE</text>

          <!-- hero balance -->
          <text x="280" y="76" text-anchor="middle" font-size="10.5" letter-spacing="1.6" fill="#A39A8E" font-weight="500">TOTAL BALANCE · ALL ACCOUNTS</text>
          <text x="280" y="112" text-anchor="middle" class="sans" font-size="32" font-weight="700" fill="#1A1714" letter-spacing="-0.5">$128,914.52</text>
          <g transform="translate(280 122)">
            <rect class="do-trend-pill-bg" x="-62" y="0" width="124" height="24" rx="12" fill="#2F6B4E" fill-opacity="0.1"/>
            <text x="0" y="16" text-anchor="middle" font-size="11" font-weight="700" fill="#2F6B4E">▲ 12.4% this month</text>
          </g>

          <!-- quick counts -->
          <g transform="translate(18 168)">
            <rect x="0" y="0" width="168" height="52" rx="9" fill="#FFFFFF" stroke="#E8E2D8"/>
            <text x="84" y="26" text-anchor="middle" class="sans" font-size="18" font-weight="700" fill="#1A1714">46</text>
            <text x="84" y="42" text-anchor="middle" font-size="9.5" fill="#6B6357" letter-spacing="0.5">INVOICES</text>
            <rect x="176" y="0" width="168" height="52" rx="9" fill="#FFFFFF" stroke="#E8E2D8"/>
            <text x="260" y="26" text-anchor="middle" class="sans" font-size="18" font-weight="700" fill="#1A1714">11</text>
            <text x="260" y="42" text-anchor="middle" font-size="9.5" fill="#6B6357" letter-spacing="0.5">BILLS</text>
            <rect x="352" y="0" width="168" height="52" rx="9" fill="#FFFFFF" stroke="#E8E2D8"/>
            <text x="436" y="26" text-anchor="middle" class="sans" font-size="18" font-weight="700" fill="#1A1714">3</text>
            <text x="436" y="42" text-anchor="middle" font-size="9.5" fill="#6B6357" letter-spacing="0.5">BANK FEEDS</text>
          </g>

          <!-- feed header -->
          <text x="18" y="240" font-size="10.5" letter-spacing="1" fill="#6B6357" font-weight="600">RECENT ACTIVITY</text>
          <text x="542" y="240" text-anchor="end" font-size="10.5" fill="#2F6B4E" font-weight="600">auto-categorized</text>

          <!-- feed rows -->
          <g transform="translate(18 250)">
            <!-- row 1: Stripe payout -->
            <rect x="0" y="0" width="524" height="42" rx="8" fill="#FFFFFF" stroke="#E8E2D8"/>
            <rect class="do-row-highlight do-row-highlight--1" x="0" y="0" width="524" height="42" rx="8" fill="#2F6B4E" fill-opacity="0" stroke="#2F6B4E" stroke-opacity="0"/>
            <circle class="do-cat-dot do-cat-dot--1" cx="16" cy="21" r="4" fill="#2F6B4E"/>
            <text x="30" y="25" class="sans" font-size="12" font-weight="500" fill="#1A1714">Stripe payout</text>
            <text class="do-row-cat" x="260" y="25" font-size="10" font-weight="600" fill="#2F6B4E">Sales</text>
            <text x="470" y="25" text-anchor="end" font-size="11.5" font-weight="600" fill="#2F6B4E">+$18,402</text>
            <g transform="translate(508 21)">
              <g class="do-row-tick do-row-tick--1">
                <circle r="7" fill="#2F6B4E"/>
                <path d="M-3 0 L-1 2.4 L3.2 -2.4" stroke="#FFFFFF" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
              </g>
            </g>
            <!-- row 2: Cedar & Co. -->
            <rect x="0" y="50" width="524" height="42" rx="8" fill="#FFFFFF" stroke="#E8E2D8"/>
            <rect class="do-row-highlight do-row-highlight--2" x="0" y="50" width="524" height="42" rx="8" fill="#2F6B4E" fill-opacity="0" stroke="#2F6B4E" stroke-opacity="0"/>
            <circle class="do-cat-dot do-cat-dot--2" cx="16" cy="71" r="4" fill="#6B21A8"/>
            <text x="30" y="75" class="sans" font-size="12" font-weight="500" fill="#1A1714">Cedar &amp; Co.</text>
            <text class="do-row-cat" x="260" y="75" font-size="10" font-weight="600" fill="#6B21A8">Prof. Services</text>
            <text x="470" y="75" text-anchor="end" font-size="11.5" font-weight="600" fill="#1A1714">−$4,280</text>
            <g transform="translate(508 71)">
              <g class="do-row-tick do-row-tick--2">
                <circle r="7" fill="#2F6B4E"/>
                <path d="M-3 0 L-1 2.4 L3.2 -2.4" stroke="#FFFFFF" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
              </g>
            </g>
            <!-- row 3: AWS -->
            <rect x="0" y="100" width="524" height="42" rx="8" fill="#FFFFFF" stroke="#E8E2D8"/>
            <rect class="do-row-highlight do-row-highlight--3" x="0" y="100" width="524" height="42" rx="8" fill="#2F6B4E" fill-opacity="0" stroke="#2F6B4E" stroke-opacity="0"/>
            <circle class="do-cat-dot do-cat-dot--3" cx="16" cy="121" r="4" fill="#0E7490"/>
            <text x="30" y="125" class="sans" font-size="12" font-weight="500" fill="#1A1714">AWS · infra</text>
            <text class="do-row-cat" x="260" y="125" font-size="10" font-weight="600" fill="#0E7490">Infrastructure</text>
            <text x="470" y="125" text-anchor="end" font-size="11.5" font-weight="600" fill="#1A1714">−$612</text>
            <g transform="translate(508 121)">
              <g class="do-row-tick do-row-tick--3">
                <circle r="7" fill="#2F6B4E"/>
                <path d="M-3 0 L-1 2.4 L3.2 -2.4" stroke="#FFFFFF" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
              </g>
            </g>
          </g>

          <!-- footer -->
          <line x1="0" y1="400" x2="560" y2="400" stroke="#E8E2D8"/>
          <rect x="0" y="400" width="560" height="40" fill="#14100E" opacity="0.02"/>
          <g transform="translate(18 420)">
            <rect x="0" y="-10" width="52" height="20" rx="10" fill="#FFFFFF" stroke="#E8E2D8"/>
            <circle class="do-device-dot" cx="12" cy="0" r="3" fill="#2F6B4E"/>
            <text x="21" y="4" class="sans" font-size="10.5" font-weight="600" fill="#1A1714">iOS</text>
            <rect x="60" y="-10" width="82" height="20" rx="10" fill="#FFFFFF" stroke="#E8E2D8"/>
            <circle class="do-device-dot" cx="72" cy="0" r="3" fill="#2F6B4E"/>
            <text x="81" y="4" class="sans" font-size="10.5" font-weight="600" fill="#1A1714">Android</text>
            <rect x="150" y="-10" width="66" height="20" rx="10" fill="#FFFFFF" stroke="#E8E2D8"/>
            <circle class="do-device-dot" cx="162" cy="0" r="3" fill="#2F6B4E"/>
            <text x="171" y="4" class="sans" font-size="10.5" font-weight="600" fill="#1A1714">Web</text>
          </g>
          <text class="do-foot-sync" x="542" y="424" text-anchor="end" font-size="10.5" font-weight="600" fill="#2F6B4E">synced continuously</text>
        </svg>
      </div>
    </div>
  </section>

  <!-- ── H2 Section 1 Divider ──────────────────────────────── -->
  <section class="b4s2" aria-labelledby="what-heading">
    <h2 id="what-heading">What is Online Accounting Software?</h2>
    <p>
      Online accounting software, also known as cloud accounting, is a web-based application
      that streamlines your financial tasks — accessible from any device with an internet connection.
    </p>
  </section>

  <!-- ── H2 Section 1 Content ──────────────────────────────── -->
  <section class="content-section bg-subtle" aria-label="Online accounting software features">
    <div class="container">

      <!-- H3: What it does -->
      <div class="feature-block">
        <h3 class="feature-block-heading">What It Does</h3>
        <p class="feature-block-body">
          Cloud accounting replaces manual bookkeeping with an always-on platform that handles
          the full range of day-to-day financial tasks.
        </p>
        <ul class="feature-list">
          <li>Generate and send invoices</li>
          <li>Track income and expenses</li>
          <li>Reconcile bank statements</li>
          <li>Manage inventory</li>
          <li>Create financial reports</li>
          <li>Collaborate with your accountant</li>
        </ul>
      </div>

      <!-- H3: Key capabilities -->
      <div class="feature-block">
        <h3 class="feature-block-heading">Key Capabilities</h3>
        <p class="feature-block-body">
          The best platforms do more than store numbers — they actively reduce errors, save time,
          and keep your data secure and accessible.
        </p>
        <ul class="criteria-list">
          <li>
            <strong>Streamlined Financial Management</strong>
            <p>Automates tedious tasks such as transaction recording, invoicing, and expense tracking. Say goodbye to manual data entry and hello to processes that save time and reduce errors.</p>
          </li>
          <li>
            <strong>Real-Time Access Anywhere, Anytime</strong>
            <p>Access your financial data from any device with an internet connection — whether you're in the office, at home, or on the go. Stay connected and make informed decisions wherever you are.</p>
          </li>
          <li>
            <strong>Enhanced Collaboration</strong>
            <p>Multiple users can work on the same files simultaneously, ensuring everyone is on the same page. Share access with your accountant or bookkeeper in seconds.</p>
          </li>
          <li>
            <strong>Scalability and Adaptability</strong>
            <p>As your business grows, your accounting needs will evolve. Online accounting is designed to scale with you — from freelancer to large corporation — without costly migrations.</p>
          </li>
          <li>
            <strong>Data Security and Backup</strong>
            <p>Advanced encryption and security protocols protect your sensitive information. Automated data backup ensures your data is always safe and accessible, even after a hardware failure.</p>
          </li>
        </ul>
      </div>

      <!-- H3: Benefits -->
      <div class="feature-block">
        <h3 class="feature-block-heading">Benefits of Using Online Accounting Software</h3>
        <p class="feature-block-body">
          There are numerous advantages to adopting online accounting for your business — from
          day-to-day efficiency gains to long-term strategic clarity.
        </p>
        <ul class="criteria-list">
          <li>
            <strong>Efficiency and Automation</strong>
            <p>Many platforms automatically categorize transactions and reconcile bank statements, saving you countless hours of manual data entry.</p>
          </li>
          <li>
            <strong>Accessibility and Mobility</strong>
            <p>Access your financial data from any device, ensuring you always have a real-time view of your business health — from anywhere.</p>
          </li>
          <li>
            <strong>Seamless Collaboration</strong>
            <p>Share financial information with your accountant or bookkeeper effortlessly, facilitating smoother workflows and faster decisions.</p>
          </li>
          <li>
            <strong>Improved Cash Flow Management</strong>
            <p>Gain valuable insights into your income and expenses, enabling you to make informed financial decisions and optimize cash flow.</p>
          </li>
          <li>
            <strong>Simplified Tax Preparation</strong>
            <p>Having your finances meticulously organized streamlines tax season, potentially saving you money on accounting fees and CRA headaches.</p>
          </li>
        </ul>
      </div>

    </div>
  </section>

  <!-- ── Accent Divider ────────────────────────────────────── -->
  <div class="accent-rule" aria-hidden="true"></div>

  <!-- ── Mid-page CTA ───────────────────────────────────────── -->
  <section class="mid-cta" aria-label="Try Accountium">

    <div class="cs-embed">
      <svg viewBox="0 0 560 330" role="img" aria-label="Accountium — cloud sync and real-time collaboration">
        <defs>
          <radialGradient id="csCloudGlow" cx="50%" cy="45%" r="60%">
            <stop offset="0%" stop-color="#2F6B4E" stop-opacity="0.14"/>
            <stop offset="100%" stop-color="#2F6B4E" stop-opacity="0"/>
          </radialGradient>
          <radialGradient id="csBgGlowA" cx="0%" cy="0%" r="60%">
            <stop offset="0%" stop-color="#2F6B4E" stop-opacity="0.10"/>
            <stop offset="100%" stop-color="#2F6B4E" stop-opacity="0"/>
          </radialGradient>
          <radialGradient id="csBgGlowB" cx="100%" cy="100%" r="60%">
            <stop offset="0%" stop-color="#1D4ED8" stop-opacity="0.07"/>
            <stop offset="100%" stop-color="#1D4ED8" stop-opacity="0"/>
          </radialGradient>
          <clipPath id="csCardClip">
            <rect x="0.5" y="0.5" width="559" height="329" rx="14"/>
          </clipPath>
        </defs>

        <!-- card background -->
        <g clip-path="url(#csCardClip)">
          <rect x="0" y="0" width="560" height="330" fill="url(#csBgGlowA)"/>
          <rect x="0" y="0" width="560" height="330" fill="url(#csBgGlowB)"/>
        </g>
        <rect x="0.5" y="0.5" width="559" height="329" rx="14" fill="none" stroke="#E8E2D8"/>

        <!-- chrome bar -->
        <line x1="0" y1="48" x2="560" y2="48" stroke="#E8E2D8"/>
        <circle cx="26" cy="24" r="5" fill="#E07A5F"/>
        <circle cx="42" cy="24" r="5" fill="#E2B33C"/>
        <circle cx="58" cy="24" r="5" fill="#2F6B4E"/>
        <text class="cs-title-text" x="280" y="28" text-anchor="middle" font-size="12" fill="#6B6357" letter-spacing="0.5">accountium / cloud</text>
        <circle class="cs-live-dot" cx="500" cy="24" r="3.5" fill="#2F6B4E"/>
        <text x="512" y="28" font-size="11" fill="#2F6B4E" font-weight="700" letter-spacing="1">LIVE</text>

        <!-- scene -->
        <circle cx="280" cy="150" r="120" fill="url(#csCloudGlow)"/>
        <circle class="cs-ring cs-ring--1" cx="280" cy="150" r="70" fill="none" stroke="#2F6B4E" stroke-width="1"/>
        <circle class="cs-ring cs-ring--2" cx="280" cy="150" r="70" fill="none" stroke="#2F6B4E" stroke-width="1"/>

        <path d="M 90 96  Q 185 70, 280 150"  fill="none" stroke="#D7CFC2" stroke-width="1.3" stroke-dasharray="3 5"/>
        <path d="M 470 84 Q 375 60, 280 150"  fill="none" stroke="#D7CFC2" stroke-width="1.3" stroke-dasharray="3 5"/>
        <path d="M 470 236 Q 375 210, 280 150" fill="none" stroke="#D7CFC2" stroke-width="1.3" stroke-dasharray="3 5"/>

        <circle class="cs-packet cs-packet--you"  r="4.5" fill="#2F6B4E"/>
        <circle class="cs-packet cs-packet--acct" r="4.5" fill="#1D4ED8"/>
        <circle class="cs-packet cs-packet--book" r="4.5" fill="#6B21A8"/>

        <!-- cloud -->
        <g transform="translate(218 110)">
          <path d="M28 58 C10 58 0 46 0 34 C0 22 10 12 22 12 C25 2 36 -4 48 0 C56 -6 70 -4 76 6 C92 4 108 14 108 30 C108 44 96 58 80 58 Z"
            fill="#FFFFFF" stroke="#1A1714" stroke-width="1.6"/>
          <g class="cs-cloud-glyph" transform="translate(54 26)">
            <path d="M-9 0a9 9 0 0 1 16.8-4.2M9 0a9 9 0 0 1-16.8 4.2" stroke="#2F6B4E" stroke-width="1.8" stroke-linecap="round" fill="none"/>
            <path d="M6.6 -6.6v4.8H2" stroke="#2F6B4E" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            <path d="M-6.6 6.6v-4.8H-2" stroke="#2F6B4E" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </g>
        </g>

        <!-- You -->
        <g>
          <circle class="cs-node-glow cs-node-glow--you" cx="90" cy="96" r="23" fill="#2F6B4E"/>
          <circle cx="90" cy="96" r="20" fill="#2F6B4E" stroke="#FFFFFF" stroke-width="2"/>
          <text x="90" y="100" text-anchor="middle" font-size="12" font-weight="700" fill="#FFFFFF">MO</text>
          <rect x="63" y="122" width="54" height="18" rx="9" fill="#FFFFFF" stroke="#E8E2D8"/>
          <text x="90" y="134" text-anchor="middle" class="sans" font-size="10.5" font-weight="600" fill="#1A1714">You</text>
        </g>

        <!-- Accountant -->
        <g>
          <circle class="cs-node-glow cs-node-glow--acct" cx="470" cy="84" r="23" fill="#1D4ED8"/>
          <circle cx="470" cy="84" r="20" fill="#1D4ED8" stroke="#FFFFFF" stroke-width="2"/>
          <text x="470" y="88" text-anchor="middle" font-size="12" font-weight="700" fill="#FFFFFF">DR</text>
          <rect x="430" y="110" width="80" height="18" rx="9" fill="#FFFFFF" stroke="#E8E2D8"/>
          <text x="470" y="122" text-anchor="middle" class="sans" font-size="10.5" font-weight="600" fill="#1A1714">Accountant</text>
        </g>

        <!-- Bookkeeper -->
        <g>
          <circle class="cs-node-glow cs-node-glow--book" cx="470" cy="236" r="23" fill="#6B21A8"/>
          <circle cx="470" cy="236" r="20" fill="#6B21A8" stroke="#FFFFFF" stroke-width="2"/>
          <text x="470" y="240" text-anchor="middle" font-size="12" font-weight="700" fill="#FFFFFF">SH</text>
          <rect x="426" y="262" width="88" height="18" rx="9" fill="#FFFFFF" stroke="#E8E2D8"/>
          <text x="470" y="274" text-anchor="middle" class="sans" font-size="10.5" font-weight="600" fill="#1A1714">Bookkeeper</text>
        </g>

        <!-- footer -->
        <line x1="0" y1="296" x2="560" y2="296" stroke="#E8E2D8"/>
        <rect x="0" y="296" width="560" height="34" fill="#14100E" opacity="0.02"/>
        <circle cx="32" cy="313" r="11" fill="#2F6B4E" stroke="#FFFFFF" stroke-width="2"/>
        <text x="32" y="317" text-anchor="middle" font-size="9" font-weight="700" fill="#FFFFFF">MO</text>
        <circle cx="48" cy="313" r="11" fill="#1D4ED8" stroke="#FFFFFF" stroke-width="2"/>
        <text x="48" y="317" text-anchor="middle" font-size="9" font-weight="700" fill="#FFFFFF">DR</text>
        <circle cx="64" cy="313" r="11" fill="#6B21A8" stroke="#FFFFFF" stroke-width="2"/>
        <text x="64" y="317" text-anchor="middle" font-size="9" font-weight="700" fill="#FFFFFF">SH</text>
        <text x="86" y="317" font-size="11" fill="#6B6357">3 collaborators online</text>
        <text class="cs-foot-sync" x="542" y="317" text-anchor="end" font-size="10.5" font-weight="600" fill="#2F6B4E">synced continuously</text>
      </svg>
    </div>

    <div class="btn-wrap">
      <a href={site.appUrl} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
        TRY NOW
      </a>
    </div>
  </section>

  <!-- ── H2 Section 2 Divider ──────────────────────────────── -->
  <section class="b4s2" aria-labelledby="choosing-heading">
    <h2 id="choosing-heading">Choosing the Right Cloud Accounting Software</h2>
    <p>
      With a multitude of online accounting solutions on the market, it's crucial to select one
      that aligns with your specific needs and budget.
    </p>
  </section>

  <!-- ── H2 Section 2 Content ──────────────────────────────── -->
  <section class="content-section" aria-label="Choosing software and why Accountium">
    <div class="container">

      <!-- H3: Selection criteria -->
      <div class="feature-block">
        <h3 class="feature-block-heading">What to Look For</h3>
        <p class="feature-block-body">
          Evaluate each platform against these five factors before committing — they will determine
          whether the software grows with you or holds you back.
        </p>
        <ul class="criteria-list">
          <li>
            <strong>Business Size &amp; Complexity</strong>
            <p>Are you a solopreneur or a larger company with multiple employees? The features you require will vary depending on the scale of your operations.</p>
          </li>
          <li>
            <strong>Budget</strong>
            <p>Online accounting software pricing structures can differ significantly. Determine your budget constraints before exploring various options.</p>
          </li>
          <li>
            <strong>Ease of Use</strong>
            <p>Consider your technical expertise and prioritize user-friendly platforms with intuitive interfaces and helpful tutorials.</p>
          </li>
          <li>
            <strong>Scalability</strong>
            <p>If you anticipate significant business growth, choose software that can adapt to your evolving needs without costly migrations.</p>
          </li>
          <li>
            <strong>Integrations</strong>
            <p>Does the software integrate with your existing business tools, such as CRM or inventory management systems? Streamlining workflows through integrations can significantly enhance efficiency.</p>
          </li>
        </ul>
      </div>

      <!-- H3: Why Accountium -->
      <div class="feature-block">
        <h3 class="feature-block-heading">Why Accountium is the Best Choice for You</h3>
