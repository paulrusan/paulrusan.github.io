---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const canonicalURL = new URL('/accounting-software', site.url).href;
---

<BaseLayout
  title="Accounting Software Online"
  description="Conquer your finances with Accountium's online accounting software. Streamline invoicing, expense tracking, bank reconciliation, and financial reporting — anytime, anywhere."
  canonicalURL={canonicalURL}
>

  <!-- ── Page Hero ─────────────────────────────────────────── -->
  <section class="b4s2s1 page-hero" aria-label="Accounting Software overview">
    <div class="b4s2s1-inner">
      <span class="label">Accounting</span>
      <h1>Accounting Software Online</h1>
      <p>
        A guide to the best online accounting software — powerful, user-friendly, and accessible
        from any device, anytime, anywhere. In today's digital age, there's no need to be chained
        to a desk drowning in receipts and spreadsheets.
      </p>
      <p>
        For businesses of all sizes, managing finances can be a daunting task — but with the advent
        of cloud accounting, the process has never been easier.
      </p>
      <div class="btn-wrap">
        <a href={site.appUrl} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
          TRY NOW
        </a>
      </div>

      <!-- ── SVG Animation Placeholder 1 ── -->
      <div class="svg-placeholder" aria-label="Accounting software animation placeholder" role="img">
        <div class="svg-placeholder-inner">
          <span class="svg-placeholder-icon" aria-hidden="true">▦</span>
          <p class="svg-placeholder-label">Accounting Software Animation — Placeholder</p>
          <p class="svg-placeholder-hint">Replace with an SVG animation showing the accounting dashboard</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── H2 Section 1 Divider ──────────────────────────────── -->
  <section class="b4s2" aria-labelledby="what-heading">
    <h2 id="what-heading">What is Online Accounting Software?</h2>
    <p>
      Online accounting software, also known as cloud accounting, is a web-based application
      that streamlines your financial tasks — accessible from any device with an internet connection.
    </p>
  </section>

  <!-- ── H2 Section 1 Content ──────────────────────────────── -->
  <section class="content-section bg-subtle" aria-label="Online accounting software features">
    <div class="container">

      <!-- H3: What it does -->
      <div class="feature-block">
        <h3 class="feature-block-heading">What It Does</h3>
        <p class="feature-block-body">
          Cloud accounting replaces manual bookkeeping with an always-on platform that handles
          the full range of day-to-day financial tasks.
        </p>
        <ul class="feature-list">
          <li>Generate and send invoices</li>
          <li>Track income and expenses</li>
          <li>Reconcile bank statements</li>
          <li>Manage inventory</li>
          <li>Create financial reports</li>
          <li>Collaborate with your accountant</li>
        </ul>
      </div>

      <!-- H3: Key capabilities -->
      <div class="feature-block">
        <h3 class="feature-block-heading">Key Capabilities</h3>
        <p class="feature-block-body">
          The best platforms do more than store numbers — they actively reduce errors, save time,
          and keep your data secure and accessible.
        </p>
        <ul class="criteria-list">
          <li>
            <strong>Streamlined Financial Management</strong>
            <p>Automates tedious tasks such as transaction recording, invoicing, and expense tracking. Say goodbye to manual data entry and hello to processes that save time and reduce errors.</p>
          </li>
          <li>
            <strong>Real-Time Access Anywhere, Anytime</strong>
            <p>Access your financial data from any device with an internet connection — whether you're in the office, at home, or on the go. Stay connected and make informed decisions wherever you are.</p>
          </li>
          <li>
            <strong>Enhanced Collaboration</strong>
            <p>Multiple users can work on the same files simultaneously, ensuring everyone is on the same page. Share access with your accountant or bookkeeper in seconds.</p>
          </li>
          <li>
            <strong>Scalability and Adaptability</strong>
            <p>As your business grows, your accounting needs will evolve. Online accounting is designed to scale with you — from freelancer to large corporation — without costly migrations.</p>
          </li>
          <li>
            <strong>Data Security and Backup</strong>
            <p>Advanced encryption and security protocols protect your sensitive information. Automated data backup ensures your data is always safe and accessible, even after a hardware failure.</p>
          </li>
        </ul>
      </div>

      <!-- H3: Benefits -->
      <div class="feature-block">
        <h3 class="feature-block-heading">Benefits of Using Online Accounting Software</h3>
        <p class="feature-block-body">
          There are numerous advantages to adopting online accounting for your business — from
          day-to-day efficiency gains to long-term strategic clarity.
        </p>
        <ul class="criteria-list">
          <li>
            <strong>Efficiency and Automation</strong>
            <p>Many platforms automatically categorize transactions and reconcile bank statements, saving you countless hours of manual data entry.</p>
          </li>
          <li>
            <strong>Accessibility and Mobility</strong>
            <p>Access your financial data from any device, ensuring you always have a real-time view of your business health — from anywhere.</p>
          </li>
          <li>
            <strong>Seamless Collaboration</strong>
            <p>Share financial information with your accountant or bookkeeper effortlessly, facilitating smoother workflows and faster decisions.</p>
          </li>
          <li>
            <strong>Improved Cash Flow Management</strong>
            <p>Gain valuable insights into your income and expenses, enabling you to make informed financial decisions and optimize cash flow.</p>
          </li>
          <li>
            <strong>Simplified Tax Preparation</strong>
            <p>Having your finances meticulously organized streamlines tax season, potentially saving you money on accounting fees and CRA headaches.</p>
          </li>
        </ul>
      </div>

    </div>
  </section>

  <!-- ── Accent Divider ────────────────────────────────────── -->
  <div class="accent-rule" aria-hidden="true"></div>

  <!-- ── Mid-page CTA ───────────────────────────────────────── -->
  <section class="mid-cta" aria-label="Try Accountium">
    <div class="svg-placeholder svg-placeholder--mid" aria-label="Feature animation placeholder" role="img">
      <div class="svg-placeholder-inner">
        <span class="svg-placeholder-icon" aria-hidden="true">◎</span>
        <p class="svg-placeholder-label">Cloud Accounting Animation — Placeholder</p>
        <p class="svg-placeholder-hint">Replace with an SVG animation showing cloud sync or collaboration</p>
      </div>
    </div>
    <div class="btn-wrap">
      <a href={site.appUrl} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
        TRY NOW
      </a>
    </div>
  </section>

  <!-- ── H2 Section 2 Divider ──────────────────────────────── -->
  <section class="b4s2" aria-labelledby="choosing-heading">
    <h2 id="choosing-heading">Choosing the Right Cloud Accounting Software</h2>
    <p>
      With a multitude of online accounting solutions on the market, it's crucial to select one
      that aligns with your specific needs and budget.
    </p>
  </section>

  <!-- ── H2 Section 2 Content ──────────────────────────────── -->
  <section class="content-section" aria-label="Choosing software and why Accountium">
    <div class="container">

      <!-- H3: Selection criteria -->
      <div class="feature-block">
        <h3 class="feature-block-heading">What to Look For</h3>
        <p class="feature-block-body">
          Evaluate each platform against these five factors before committing — they will determine
          whether the software grows with you or holds you back.
        </p>
        <ul class="criteria-list">
          <li>
            <strong>Business Size &amp; Complexity</strong>
            <p>Are you a solopreneur or a larger company with multiple employees? The features you require will vary depending on the scale of your operations.</p>
          </li>
          <li>
            <strong>Budget</strong>
            <p>Online accounting software pricing structures can differ significantly. Determine your budget constraints before exploring various options.</p>
          </li>
          <li>
            <strong>Ease of Use</strong>
            <p>Consider your technical expertise and prioritize user-friendly platforms with intuitive interfaces and helpful tutorials.</p>
          </li>
          <li>
            <strong>Scalability</strong>
            <p>If you anticipate significant business growth, choose software that can adapt to your evolving needs without costly migrations.</p>
          </li>
          <li>
            <strong>Integrations</strong>
            <p>Does the software integrate with your existing business tools, such as CRM or inventory management systems? Streamlining workflows through integrations can significantly enhance efficiency.</p>
          </li>
        </ul>
      </div>

      <!-- H3: Why Accountium -->
      <div class="feature-block">
        <h3 class="feature-block-heading">Why Accountium is the Best Choice for You</h3>
        <p class="feature-block-body">
          While there are many great online accounting options available, Accountium stands out
          as a leader across every selection criterion.
        </p>
        <ul class="criteria-list">
          <li>
            <strong>Award-Winning Design</strong>
            <p>Accountium boasts an elegant and user-friendly interface, making it easy to navigate even for those with limited accounting experience.</p>
          </li>
          <li>
            <strong>Industry-Leading AI Tools</strong>
            <p>Cutting-edge artificial intelligence automates tasks, generates real-time financial insights, and identifies growth opportunities — all without extra effort from you.</p>
          </li>
          <li>
            <strong>Seamless Cloud Accounting</strong>
            <p>Enjoy the flexibility and security of cloud-based accounting, allowing you to access your financial data from any device and collaborate effortlessly with your accountant.</p>
          </li>
          <li>
            <strong>Complete Business Management</strong>
            <p>Accountium goes beyond basic accounting, offering features for streamlining sales, managing inventory, and keeping a watchful eye on cash flow.</p>
          </li>
        </ul>
      </div>

    </div>
  </section>

  <!-- ── Final CTA Divider ─────────────────────────────────── -->
  <section class="b4s2" aria-labelledby="cta-heading">
    <h2 id="cta-heading">Discover the Power of Accountium</h2>
    <p>
      By leveraging the power of online accounting software, you can transform your financial
      management from a burden into a strategic advantage. Select the perfect solution to empower
      your business growth and achieve financial peace of mind.
    </p>
    <div class="btn-wrap">
      <a href={site.appUrl} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
        TRY NOW
      </a>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero ───────────────────────────────────────────────── */
  .page-hero {
    padding-top: calc(var(--header-height) + var(--space-16));
    background:
      radial-gradient(ellipse 70% 50% at 50% -5%, rgba(8, 145, 178, 0.07) 0%, transparent 60%),
      var(--color-bg);
  }

  .page-hero.b4s2s1::before { display: none; }

  /* ── Button spacing wrapper ─────────────────────────────── */
  .btn-wrap {
    display: flex;
    justify-content: center;
    margin: var(--space-8) 0;
  }

  /* ── SVG Placeholders ───────────────────────────────────── */
  .svg-placeholder {
    width: 100%;
    max-width: 540px;
    aspect-ratio: 16 / 9;
    margin: 0 auto;
    border-radius: var(--radius-lg);
    border: 1.5px dashed var(--color-accent);
    background: rgba(8, 145, 178, 0.04);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .svg-placeholder--mid {
    margin: 0 auto var(--space-6);
  }

  .svg-placeholder-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
    padding: var(--space-6);
  }

  .svg-placeholder-icon {
    font-size: 2.4rem;
    color: var(--color-accent);
    opacity: 0.5;
  }

  .svg-placeholder-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
    margin: 0;
    max-width: none;
  }

  .svg-placeholder-hint {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    opacity: 0.65;
    margin: 0;
    max-width: none;
  }

  /* ── Content Sections ──────────────────────────────────── */
  .content-section {
    padding: var(--space-16) 0;
  }

  .bg-subtle {
    background: rgba(8, 145, 178, 0.03);
  }

  /* ── Feature Blocks ─────────────────────────────────────── */
  .feature-block {
    margin-bottom: var(--space-16);
  }

  .feature-block:last-child {
    margin-bottom: 0;
  }

  .feature-block-heading {
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .feature-block-body {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.8;
    max-width: 66ch;
    margin: 0 auto var(--space-8);
    text-align: center;
  }

  /* ── Accent Rule (standalone vertical line divider) ────────── */
  .accent-rule {
    position: relative;
    height: var(--space-32);
    width: 100%;
    margin: var(--space-8) 0;
  }

  .accent-rule::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 100%;
    background: linear-gradient(to bottom, transparent, var(--color-accent), transparent);
  }

  /* ── Mid CTA ─────────────────────────────────────────────── */
  .mid-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-12) var(--space-8);
    gap: var(--space-6);
    background: rgba(8, 145, 178, 0.03);
  }

  /* ── Feature list (simple checkmark bullets) ────────────── */
  .feature-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    list-style: none;
    padding: 0;
    margin: 0 auto;
    justify-content: center;
    max-width: 700px;
  }

  .feature-list li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .feature-list li::before {
    content: '✓';
    color: var(--color-accent);
    font-weight: 700;
    flex-shrink: 0;
  }

  /* ── Criteria List (bold label + description bullets) ───── */
  .criteria-list {
    list-style: none;
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: 0;
  }

  .criteria-list li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-left: var(--space-6);
    position: relative;
  }

  .criteria-list li::before {
    content: "◈";
    position: absolute;
    left: 0;
    top: 2px;
    font-size: var(--text-xs);
    color: var(--color-accent);
  }

  .criteria-list strong {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }

  .criteria-list p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
    max-width: none;
  }

  /* ── b4s2: Accent Section Divider ───────────────────────── */
  .b4s2 {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: var(--space-6);
    padding: var(--space-16) var(--space-8);
    position: relative;
    background: radial-gradient(ellipse at 50% 80%, rgba(8, 145, 178, 0.06) 0%, transparent 50%);
  }

  .b4s2::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: var(--space-16);
    background: linear-gradient(to bottom, transparent, var(--color-accent), transparent);
  }

  .b4s2 h2 {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
  }

  .b4s2 p {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 58ch;
    margin: 0;
  }

  /* ── b4s2s1: Hero Text Section ──────────────────────────── */
  .b4s2s1 {
    padding: var(--space-16) var(--space-8);
    position: relative;
  }

  .b4s2s1::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: var(--space-16);
    background: linear-gradient(to bottom, transparent, var(--color-accent), transparent);
  }

  .b4s2s1-inner {
    max-width: 68ch;
    margin: 0 auto;
    text-align: center;
  }

  .page-hero.b4s2s1 .b4s2s1-inner .btn {
    display: inline-flex;
  }

  .b4s2s1 .label {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-accent);
    margin-bottom: var(--space-4);
  }

  .b4s2s1 h1 {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--color-text-primary);
    margin-bottom: var(--space-6);
  }

  .b4s2s1 p {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.8;
    max-width: none;
    margin-bottom: var(--space-5);
  }

  .b4s2s1 p:last-child { margin-bottom: 0; }

  /* ── Responsive ─────────────────────────────────────────── */
  @media (max-width: 600px) {
    .b4s2s1 h1            { font-size: var(--text-xl); }
    .feature-block-heading { font-size: var(--text-lg); }
  }
</style>
