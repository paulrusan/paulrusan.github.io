---
// ╔══════════════════════════════════════════════════════════════╗
// ║  POST PAGE TEMPLATE                                          ║
// ║  Based on: accounting-platform.astro                        ║
// ║                                                              ║
// ║  HOW TO USE:                                                 ║
// ║  1. Copy this file to src/pages/your-page-slug.astro        ║
// ║  2. Replace every PLACEHOLDER_ value below                  ║
// ║  3. Add/remove feature-block sections as needed             ║
// ║  4. Swap SVG placeholders for real animations when ready    ║
// ║  5. Add the page to src/data/resources.ts                   ║
// ╚══════════════════════════════════════════════════════════════╝

import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

// PLACEHOLDER_SLUG  e.g. 'accounting-platform'
const slug = 'PLACEHOLDER_SLUG';
const canonicalURL = new URL(`/${slug}`, site.url).href;
---

<BaseLayout
  title="PLACEHOLDER_PAGE_TITLE | Accountium"
  description="PLACEHOLDER_META_DESCRIPTION (1–2 sentences, ~155 chars)"
  canonicalURL={canonicalURL}
>

  <!-- ── Page Hero ─────────────────────────────────────────── -->
  <section class="b4s2s1 page-hero" aria-label="PLACEHOLDER_ARIA_LABEL">
    <div class="b4s2s1-inner">
      <!-- Category label — matches resources.ts category value -->
      <span class="label">PLACEHOLDER_CATEGORY</span>
      <h1>PLACEHOLDER_H1</h1>
      <p>
        PLACEHOLDER_HERO_PARAGRAPH — 2–4 sentences summarising the page topic.
        Keep it punchy and benefit-led.
      </p>
      <div class="btn-wrap">
        <a href={site.appUrl} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
          TRY NOW
        </a>
      </div>

      <!-- ── SVG Animation Placeholder 1 ── -->
      <div class="svg-placeholder" aria-label="PLACEHOLDER_SVG1_ARIA" role="img">
        <div class="svg-placeholder-inner">
          <span class="svg-placeholder-icon" aria-hidden="true">▦</span>
          <p class="svg-placeholder-label">PLACEHOLDER_SVG1_LABEL — Placeholder</p>
          <p class="svg-placeholder-hint">Replace with: PLACEHOLDER_SVG1_DESCRIPTION</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── H2 Section 1 Divider ──────────────────────────────── -->
  <section class="b4s2" aria-labelledby="section1-heading">
    <h2 id="section1-heading">PLACEHOLDER_H2_SECTION1</h2>
    <p>
      PLACEHOLDER_H2_SECTION1_INTRO — 1–2 sentences setting up the content below.
    </p>
  </section>

  <!-- ── H2 Section 1 Content ──────────────────────────────── -->
  <section class="content-section bg-subtle" aria-label="PLACEHOLDER_SECTION1_ARIA">
    <div class="container">

      <!-- H3 Block — simple bullet list variant -->
      <div class="feature-block">
        <h3 class="feature-block-heading">PLACEHOLDER_H3_A</h3>
        <p class="feature-block-body">
          PLACEHOLDER_H3_A_BODY — describe the feature or topic in 2–3 sentences.
        </p>
        <ul class="feature-list">
          <li>PLACEHOLDER_BULLET_1</li>
          <li>PLACEHOLDER_BULLET_2</li>
          <li>PLACEHOLDER_BULLET_3</li>
          <li>PLACEHOLDER_BULLET_4</li>
        </ul>
      </div>

      <!-- H3 Block — criteria list (bold label + description) variant -->
      <div class="feature-block">
        <h3 class="feature-block-heading">PLACEHOLDER_H3_B</h3>
        <p class="feature-block-body">
          PLACEHOLDER_H3_B_BODY — describe the feature or topic in 2–3 sentences.
        </p>
        <ul class="criteria-list">
          <li>
            <strong>PLACEHOLDER_ITEM_1_TITLE</strong>
            <p>PLACEHOLDER_ITEM_1_DESCRIPTION</p>
          </li>
          <li>
            <strong>PLACEHOLDER_ITEM_2_TITLE</strong>
            <p>PLACEHOLDER_ITEM_2_DESCRIPTION</p>
          </li>
          <li>
            <strong>PLACEHOLDER_ITEM_3_TITLE</strong>
            <p>PLACEHOLDER_ITEM_3_DESCRIPTION</p>
          </li>
        </ul>
      </div>

      <!-- H3 Block — add more feature-blocks as needed, then delete unused ones -->
      <div class="feature-block">
        <h3 class="feature-block-heading">PLACEHOLDER_H3_C</h3>
        <p class="feature-block-body">
          PLACEHOLDER_H3_C_BODY
        </p>
        <ul class="criteria-list">
          <li>
            <strong>PLACEHOLDER_ITEM_1_TITLE</strong>
            <p>PLACEHOLDER_ITEM_1_DESCRIPTION</p>
          </li>
          <li>
            <strong>PLACEHOLDER_ITEM_2_TITLE</strong>
            <p>PLACEHOLDER_ITEM_2_DESCRIPTION</p>
          </li>
          <li>
            <strong>PLACEHOLDER_ITEM_3_TITLE</strong>
            <p>PLACEHOLDER_ITEM_3_DESCRIPTION</p>
          </li>
        </ul>
      </div>

    </div>
  </section>

  <!-- ── Accent Divider ────────────────────────────────────── -->
  <div class="accent-rule" aria-hidden="true"></div>

  <!-- ── Mid-page CTA + SVG Placeholder 2 ─────────────────── -->
  <section class="mid-cta" aria-label="PLACEHOLDER_MID_CTA_ARIA">
    <div class="svg-placeholder svg-placeholder--mid" aria-label="PLACEHOLDER_SVG2_ARIA" role="img">
      <div class="svg-placeholder-inner">
        <span class="svg-placeholder-icon" aria-hidden="true">◎</span>
        <p class="svg-placeholder-label">PLACEHOLDER_SVG2_LABEL — Placeholder</p>
        <p class="svg-placeholder-hint">Replace with: PLACEHOLDER_SVG2_DESCRIPTION</p>
      </div>
    </div>
    <div class="btn-wrap">
      <a href={site.appUrl} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
        TRY NOW
      </a>
    </div>
  </section>

  <!-- ── H2 Section 2 Divider ──────────────────────────────── -->
  <section class="b4s2" aria-labelledby="section2-heading">
    <h2 id="section2-heading">PLACEHOLDER_H2_SECTION2</h2>
    <p>
      PLACEHOLDER_H2_SECTION2_INTRO — 1–2 sentences.
    </p>
  </section>

  <!-- ── H2 Section 2 Content ──────────────────────────────── -->
  <section class="content-section" aria-label="PLACEHOLDER_SECTION2_ARIA">
    <div class="container">

      <!-- H3 Block -->
      <div class="feature-block">
        <h3 class="feature-block-heading">PLACEHOLDER_H3_D</h3>
        <p class="feature-block-body">
          PLACEHOLDER_H3_D_BODY
        </p>
        <ul class="criteria-list">
          <li>
            <strong>PLACEHOLDER_ITEM_1_TITLE</strong>
            <p>PLACEHOLDER_ITEM_1_DESCRIPTION</p>
          </li>
          <li>
            <strong>PLACEHOLDER_ITEM_2_TITLE</strong>
            <p>PLACEHOLDER_ITEM_2_DESCRIPTION</p>
          </li>
          <li>
            <strong>PLACEHOLDER_ITEM_3_TITLE</strong>
            <p>PLACEHOLDER_ITEM_3_DESCRIPTION</p>
          </li>
          <li>
            <strong>PLACEHOLDER_ITEM_4_TITLE</strong>
            <p>PLACEHOLDER_ITEM_4_DESCRIPTION</p>
          </li>
        </ul>
      </div>

      <!-- H3 Block — simple bullet list variant -->
      <div class="feature-block">
        <h3 class="feature-block-heading">PLACEHOLDER_H3_E</h3>
        <p class="feature-block-body">
          PLACEHOLDER_H3_E_BODY
        </p>
        <ul class="feature-list">
          <li>PLACEHOLDER_BULLET_1</li>
          <li>PLACEHOLDER_BULLET_2</li>
          <li>PLACEHOLDER_BULLET_3</li>
          <li>PLACEHOLDER_BULLET_4</li>
          <li>PLACEHOLDER_BULLET_5</li>
        </ul>
      </div>

      <!-- H3 Block -->
      <div class="feature-block">
        <h3 class="feature-block-heading">PLACEHOLDER_H3_F</h3>
        <p class="feature-block-body">
          PLACEHOLDER_H3_F_BODY
        </p>
        <ul class="criteria-list">
          <li>
            <strong>PLACEHOLDER_ITEM_1_TITLE</strong>
            <p>PLACEHOLDER_ITEM_1_DESCRIPTION</p>
          </li>
          <li>
            <strong>PLACEHOLDER_ITEM_2_TITLE</strong>
            <p>PLACEHOLDER_ITEM_2_DESCRIPTION</p>
          </li>
          <li>
            <strong>PLACEHOLDER_ITEM_3_TITLE</strong>
            <p>PLACEHOLDER_ITEM_3_DESCRIPTION</p>
          </li>
        </ul>
      </div>

    </div>
  </section>

  <!-- ── Final CTA Divider ─────────────────────────────────── -->
  <section class="b4s2" aria-labelledby="cta-heading">
    <h2 id="cta-heading">PLACEHOLDER_FINAL_CTA_HEADING</h2>
    <p>
      PLACEHOLDER_FINAL_CTA_BODY — 1–2 sentences. End with a clear call to action.
    </p>
    <div class="btn-wrap">
      <a href={site.appUrl} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
        TRY NOW
      </a>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero ───────────────────────────────────────────────── */
  .page-hero {
    padding-top: calc(var(--header-height) + var(--space-16));
    background:
      radial-gradient(ellipse 70% 50% at 50% -5%, rgba(8, 145, 178, 0.07) 0%, transparent 60%),
      var(--color-bg);
  }

  .page-hero.b4s2s1::before { display: none; }

  /* ── Button spacing wrapper ─────────────────────────────── */
  .btn-wrap {
    display: flex;
    justify-content: center;
    margin: var(--space-8) 0;
  }

  /* ── SVG Placeholders ───────────────────────────────────── */
  .svg-placeholder {
    width: 100%;
    max-width: 540px;
    aspect-ratio: 16 / 9;
    margin: 0 auto;
    border-radius: var(--radius-lg);
    border: 1.5px dashed var(--color-accent);
    background: rgba(8, 145, 178, 0.04);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .svg-placeholder--mid {
    margin: 0 auto var(--space-6);
  }

  .svg-placeholder-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
    padding: var(--space-6);
  }

  .svg-placeholder-icon {
    font-size: 2.4rem;
    color: var(--color-accent);
    opacity: 0.5;
  }

  .svg-placeholder-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
    margin: 0;
    max-width: none;
  }

  .svg-placeholder-hint {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    opacity: 0.65;
    margin: 0;
    max-width: none;
  }

  /* ── Content Sections ──────────────────────────────────── */
  .content-section {
    padding: var(--space-16) 0;
  }

  .bg-subtle {
    background: rgba(8, 145, 178, 0.03);
  }

  /* ── Feature Blocks ─────────────────────────────────────── */
  .feature-block {
    margin-bottom: var(--space-16);
  }

  .feature-block:last-child {
    margin-bottom: 0;
  }

  .feature-block-heading {
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .feature-block-body {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.8;
    max-width: 66ch;
    margin: 0 auto var(--space-8);
    text-align: center;
  }

  /* ── Accent Rule (standalone vertical line divider) ────────── */
  .accent-rule {
    position: relative;
    height: var(--space-32);
    width: 100%;
    margin: var(--space-8) 0;
  }

  .accent-rule::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 100%;
    background: linear-gradient(to bottom, transparent, var(--color-accent), transparent);
  }

  /* ── Mid CTA ─────────────────────────────────────────────── */
  .mid-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-12) var(--space-8);
    gap: var(--space-6);
    background: rgba(8, 145, 178, 0.03);
  }

  /* ── Feature list (simple checkmark bullets) ────────────── */
  .feature-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    list-style: none;
    padding: 0;
    margin: 0 auto;
    justify-content: center;
    max-width: 700px;
  }

  .feature-list li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .feature-list li::before {
    content: '✓';
    color: var(--color-accent);
    font-weight: 700;
    flex-shrink: 0;
  }

  /* ── Criteria List (bold label + description bullets) ───── */
  .criteria-list {
    list-style: none;
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: 0;
  }

  .criteria-list li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-left: var(--space-6);
    position: relative;
  }

  .criteria-list li::before {
    content: "◈";
    position: absolute;
    left: 0;
    top: 2px;
    font-size: var(--text-xs);
    color: var(--color-accent);
  }

  .criteria-list strong {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }

  .criteria-list p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
    max-width: none;
  }

  /* ── b4s2: Accent Section Divider ───────────────────────── */
  .b4s2 {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: var(--space-6);
    padding: var(--space-16) var(--space-8);
    position: relative;
    background: radial-gradient(ellipse at 50% 80%, rgba(8, 145, 178, 0.06) 0%, transparent 50%);
  }

  .b4s2::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: var(--space-16);
    background: linear-gradient(to bottom, transparent, var(--color-accent), transparent);
  }

  .b4s2 h2 {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
  }

  .b4s2 p {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 58ch;
    margin: 0;
  }

  /* ── b4s2s1: Hero Text Section ──────────────────────────── */
  .b4s2s1 {
    padding: var(--space-16) var(--space-8);
    position: relative;
  }

  .b4s2s1::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: var(--space-16);
    background: linear-gradient(to bottom, transparent, var(--color-accent), transparent);
  }

  .b4s2s1-inner {
    max-width: 68ch;
    margin: 0 auto;
    text-align: center;
  }

  .page-hero.b4s2s1 .b4s2s1-inner .btn {
    display: inline-flex;
  }

  .b4s2s1 .label {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-accent);
    margin-bottom: var(--space-4);
  }

  .b4s2s1 h1 {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--color-text-primary);
    margin-bottom: var(--space-6);
  }

  .b4s2s1 p {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.8;
    max-width: none;
    margin-bottom: var(--space-5);
  }

  .b4s2s1 p:last-child { margin-bottom: 0; }

  /* ── Responsive ─────────────────────────────────────────── */
  @media (max-width: 600px) {
    .b4s2s1 h1            { font-size: var(--text-xl); }
    .feature-block-heading { font-size: var(--text-lg); }
  }
</style>
